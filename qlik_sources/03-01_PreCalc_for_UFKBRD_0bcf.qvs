///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);

///$tab MapTBLs
SUB MapTBLs
	
	КА_Наименование:	
	Mapping 
	LOAD 
	    ZKHCONTR, 
	    Trim(Контрагент) as Контрагент
	FROM 
		[$(vXLSData_UFK)\_УФК БРД_общие данные\Приложения Qlik\Управление ВОК\ВОК\Контрагенты.qvd] (qvd);

ENDSUB
///$tab МТР_ВовлечениеГод
SUB МТР_ВовлечениеГод
	
	СписокДат:
	LOAD Distinct
		Year(Период) 	as Год,
		Период 			as Дата,
		[Признак Данные] 
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\МТР\МТР_Данные.qvd]
		(qvd)
	Where
		([Признак Данные]='Норматив Расход' or [Признак Данные]='Норматив Приход')
		and Year(Период)>2020;
	
	Left Join (СписокДат)
	МТР_ВовлечениеГод:
	LOAD
		[ДО Наименование],
		Год,
		sum(Сумма) as Сумма,
		[Признак Данные]
	Group By
		[ДО Наименование],
		Год,
		[Признак Данные];
	LOAD
		[Признак Данные],
		[ДО Наименование],
		Период,
		Year(Период) as Год,
		Сумма
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\МТР\МТР_Данные.qvd]
		(qvd)
	Where
		([Признак Данные]='Норматив Расход' or [Признак Данные]='Норматив Приход')
		and Year(Период)>2020;
	
	NoConcatenate
	МТР_ВовлечениеГод:
	LOAD
		[Признак Данные],
		[ДО Наименование],
		Дата as Период, 		
		Год, 
		Сумма as Данные
	Resident 
		СписокДат;
	
	DROP Table СписокДат;
		
	STORE МТР_ВовлечениеГод into $(vDataTier3)\Дашборд ВОК\Прогноз\МТР_ВовлечениеГод.qvd;
	DROP Table МТР_ВовлечениеГод;
		
ENDSUB



///$tab КЗ_Факторинг
SUB КЗ_Факторинг
	
	//факторинг только по шельф
	ZGRCCP410:
	LOAD 
		'краткосрочный факторинг' 			as [Тип платежа],
		'Шельф' 							as [ДО Наименование],
	     date(DayStart(MonthEnd(Период))) 	as Дата, 
	     Year(Период) 						as Год,
	     Month(Период) 						as Месяц,
	     'ИНН'&ИНН 							as ZKHCONTR, 
	     sum([Сумм. оборот Дт-Кт])  		as [КЗ на конец периода (без отрицательных сальдо), руб.], 
	     sum([Сумма Дт]) 					as [КЗ погашение (оборот Дт) (без отрицательных сальдо), руб.], 
	     sum([Сумма Кт]) 					as [КЗ увеличение (оборот Кт) (без отрицательных сальдо), руб.], 
	     [1С: Счет] 						as [Бухгалтерский счет], 
	     [1С: Контрагент] 					as [Контрагент Наименование]
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\SAP\Данные_1CERP.qvd]
		(qvd)
	Where 
		[1С: Счет] = '76.10.1'
		and WildMatch(ИНН,  '7727712331', '7729405872', '7802754982') //поменяла на ИНН (было ИНН_1), так как иначе не сходились суммы
		and WildMatch([МСФО: Единица отчётности (ENTITY)],  'C1102240') //C1102240 - Шельф, C1202330  - Мегион
	Group By  
		Период,
		ИНН,
		[1С: Счет],
		[1С: Контрагент];
	
	//7620302060 и 7620302080
	//все остальные (не 1С)
	Concatenate (ZGRCCP410)
	LOAD 
	 		 if([0GL_ACCOUNT]= '7620639000', 'долгосрочный факторинг',
			 if([0GL_ACCOUNT]= '7620638000', 'краткосрочный факторинг',
			 if([0GL_ACCOUNT]= '7620302010', 'комиссия за факторинг', 
			 if([0GL_ACCOUNT]= '7620302060', 'комиссия за факторинг', 
			 if([0GL_ACCOUNT]= '7620302080', 'комиссия за факторинг', 
			 
			 if([0GL_ACCOUNT]= '7620638020', 'краткосрочный факторинг',
			 if([0GL_ACCOUNT]= '7620638060', 'краткосрочный факторинг', //новое окт 2024
			 if([0GL_ACCOUNT]= '7620638010', 'краткосрочный факторинг',
			 if([0GL_ACCOUNT]= '7620638040', 'краткосрочный факторинг', //новое окт 2026
			 if([0GL_ACCOUNT]= '7620638050', 'краткосрочный факторинг', //новое окт 2026
			 if([0GL_ACCOUNT]= '7620302050', 'комиссия за факторинг',   //новое окт 2026
			 if([0GL_ACCOUNT]= '7620302040', 'комиссия за факторинг',   //новое окт 2026
			 if([0GL_ACCOUNT]= '7620302020', 'комиссия за факторинг' 
			 ))))))))))))) 						as [Тип платежа],	
	     [ДО Наименование], 
	     ZKHCONTR, 
	     ApplyMap('КА_Наименование', ZKHCONTR, ZKHCONTR) as [Контрагент Наименование],
	     
	     [0GL_ACCOUNT]  					as [Бухгалтерский счет], 
	     date(DayStart(MonthEnd(Период))) 	as Дата, 
	     Year(Период) 						as Год,
	     Month(Период) 						as Месяц,
	     sum([Выручка оборот за период]) 	as [КЗ погашение (оборот Дт) (без отрицательных сальдо), руб.], 
	     sum([Оборот за период по дебету]) 	as [КЗ увеличение (оборот Кт) (без отрицательных сальдо), руб.],
	     sum([0DEB_CRE_LC])  				as [КЗ на конец периода (без отрицательных сальдо), руб.]  //здесь пока нет  остатка на дату, только обороты
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\ZGRCCP410\ZGRCCP410_ИсходныеДанные.qvd]
		(qvd)
	Where 
		Match([0GL_ACCOUNT], '7620639000', '7620638000', '7620302010', '7620302020', '7620638020',  '7620638010','7620638060', 
		'7620302060', '7620302080',
		'7620638040', '7620638050', '7620302050', '7620302040')
		and [ДО Наименование]<>'Не найдено'  and [ДО Наименование]<>'Шельф' and  [ДО Наименование]<>'Мегион' //условие, чтобы точно их  не грузить
	Group By 
 		[ДО Наименование], 
	    ZKHCONTR, 
		[0GL_ACCOUNT],
		Период;
	
	//расчет остатка на концы месяцев по оборотам
	NoConcatenate
	ZGRCCP410_TMP:
	LOAD
		[Тип платежа],	
		[ДО Наименование], 
		ZKHCONTR, 
		[Контрагент Наименование],	
		[Бухгалтерский счет],   
		Дата,    
		[КЗ на конец периода (без отрицательных сальдо), руб.]
	Resident ZGRCCP410;
	
	//убираю это поле с оборотами, так как остаток формируется далее
	DROP Field [КЗ на конец периода (без отрицательных сальдо), руб.]  From ZGRCCP410;

	Join  (ZGRCCP410_TMP)
	[Период 1]:
	LOAD 
		Период as Дата,
		Период_Накопительно as [Период 1] 
	FROM [$(vDataTier3)\Дашборд ВОК\Лист_5 Резервы\Резервы_Календарь_Накопление.qvd](qvd);
	
	Concatenate (ZGRCCP410)
	LOAD
		[Тип платежа],	
		[ДО Наименование], 
		ZKHCONTR, 
		[Контрагент Наименование],	
		[Бухгалтерский счет],   
		fabs(sum([КЗ на конец периода (без отрицательных сальдо), руб.]))  as [КЗ на конец периода (без отрицательных сальдо), руб.],
		[Период 1]   		as Дата,
		Year([Период 1]) 	as Год,
		Month([Период 1]) 	as Месяц
	Resident 
		ZGRCCP410_TMP
	Group By 
		[Тип платежа],	
		[ДО Наименование], 
		ZKHCONTR, 
		[Контрагент Наименование],	
		[Бухгалтерский счет],  
		[Период 1];


	Concatenate (ZGRCCP410)
	LOAD
		[Тип платежа],	
		[ДО Наименование], 
		ZKHCONTR, 
		[Контрагент Наименование],	
		[Бухгалтерский счет],   
		fabs(sum([КЗ на конец периода (без отрицательных сальдо), руб.]))  as [КЗ на начало периода (без отрицательных сальдо), руб.],
		date(DayStart(MonthEnd(AddMonths([Период 1],+1))))   	as Дата,
		Year(AddMonths([Период 1],+1)) 							as Год,
		Month(AddMonths([Период 1],+1)) 						as Месяц
	Resident 
		ZGRCCP410_TMP
	Group By 
		[Тип платежа],	
		[ДО Наименование], 
		ZKHCONTR, 
		[Контрагент Наименование],	
		[Бухгалтерский счет],  
		[Период 1];

	DROP Table ZGRCCP410_TMP;	
	
	STORE ZGRCCP410 into $(vDataTier3)\Дашборд ВОК\Лист_0 Общий\КЗ_Факторинг.qvd;
	DROP Table ZGRCCP410;

ENDSUB
///$tab КПД
SUB КПД
	
	//**************************************** ЗАГРУЗКА ЗАДОЛЖЕННОСТИ		
	КК:
	LOAD * Where [Задолженность просроченная, руб.]<>0;
	LOAD
		 'ДЗ' as ПризнакДанные,
		 [Контрагент ИНН], 
		 [Договор Номер], 
		 Дата, 
		 [Контрагент Наименование], 
		 [ДО Наименование], 
	     [Подразделение Наименование],  
		 [Задолженность Вид], 
	     [Бухгалтерский счет], 
	     Комментарии,
	     RangeSum(sum([Задолженность просроченная (>30 дней) переоценка, руб.]), sum([Задолженность просроченная (>5 и <=30 дней) переоценка, руб.]),0) as [Задолженность просроченная, руб.]
	Group By 
		 [Контрагент ИНН], 
		 [Договор Номер], 
		 Дата, 
		 [Контрагент Наименование], 
		 [ДО Наименование], 
		 [Подразделение Наименование], 
		 [Задолженность Вид],
	     [Бухгалтерский счет],
	     Комментарии;
	LOAD 
		 text([Контрагент ИНН]) as [Контрагент ИНН], 
		 [Договор Номер], 
		 date(MonthStart(Дата)) as Дата, 		 
		 [Контрагент Наименование], 
		 [ДО Наименование Исходное] 					as [ДО Наименование], 
	     [Подразделение Наименование КПД] 				as [Подразделение Наименование], 
	     [Бухгалтерский счет], 
	     [Задолженность Вид], 	 	 
	 	 [Задолженность просроченная (>30 дней) переоценка, руб.], 
	     [Задолженность просроченная (>5 и <=30 дней) переоценка, руб.],
	     Комментарии
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
		(qvd)
	Where 
		not IsNull([Подразделение Наименование КПД])
		and Year(Дата)>=2024
		and [Строка Тип]='ДЗ'
		and ([Бухгалтерский счет] like '62*' or ([Бухгалтерский счет]=' 7610609000' and [Контрагент ИНН]='7725390520')) //АО "Логистика-Трейд"
		and ([Задолженность просроченная (>30 дней) переоценка, руб.]<>0 or [Задолженность просроченная (>5 и <=30 дней) переоценка, руб.]<>0)
		and not [Контрагент Тип] like '*ВЗЛ*';

	
	//**************************************** ЗАГРУЗКА РЕЗЕРВОВ
	Резервы_Excel:
	LOAD 
		 [ДО Наименование]&'_'&text([Контрагент ИНН])&'_'&text([Договор Номер])&'_'&Round([Резерв на конец периода (без отрицательных сальдо), руб.], 0.01) as KEY,
	     [Резерв на конец периода (без отрицательных сальдо), руб.]
	FROM
		[$(vDataTier1)\Excel\Дашборд ВОК\Резервы_Excel.qvd]
		(qvd);
	
	
	Concatenate (КК)
	LOAD * Where Признак=1;
	LOAD
		*,
		if(Exists(KEY, [ДО Наименование]&'_'&text([Контрагент ИНН])&'_'&text([Договор Номер])&'_'&Round(([Резерв на конец периода, руб.]), 0.01)), 1, 0) as Признак;
	LOAD		 
	 	 'Резервы' as ПризнакДанные,
		 [Контрагент ИНН], 
		 [Договор Номер], 
		 Дата, 
		 [Контрагент Наименование], 
		 [ДО Наименование], 
		 [Подразделение Наименование], 
		 [Задолженность Вид], 
	     [Бухгалтерский счет], 
	     Комментарии,
	     sum([Резерв на конец периода, руб.]) as [Резерв на конец периода, руб.]
	Group By
		 [Контрагент ИНН], 
		 [Договор Номер], 
		 Дата, 
		 [Контрагент Наименование], 
		 [ДО Наименование], 
		 [Подразделение Наименование], 
		 [Задолженность Вид], 
	     [Бухгалтерский счет], 
	     Комментарии;
	LOAD  
		 text([Контрагент ИНН]) as [Контрагент ИНН], 
		 [Договор Номер], 
		 date(MonthStart(Дата)) as Дата, 		 
		 [Контрагент Наименование], 
		 [ДО Наименование Исходное] 					as [ДО Наименование], 
	     [Подразделение Наименование КПД] 				as [Подразделение Наименование], 
	     [Бухгалтерский счет], 
	     [Задолженность Вид], 
	     Комментарии,
	     Round([Резерв на конец периода, руб.], 0.01) as [Резерв на конец периода, руб.]	 
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
		(qvd)
	Where 
		not IsNull([Подразделение Наименование КПД])
		and Year(Дата)>=2024
		and [Строка Тип]='Резервы'
		and not [Контрагент Тип] like '*ВЗЛ*';
	
	
	DROP Table Резервы_Excel;
	
	
	//**************************************** ИТОГ
	NoConcatenate
	КК_TMP:
	LOAD 
		 ПризнакДанные, 
	     [Контрагент ИНН], 
	     [Договор Номер], 
	     Дата, 
	     [Контрагент Наименование], 
	     [ДО Наименование] as [ДО Наименование Исходное], 
	     [ДО Наименование], 
	     [Подразделение Наименование], 
	     [Задолженность Вид], 
	     [Бухгалтерский счет], 
	     Комментарии,
	     sum([Задолженность просроченная, руб.]) 		as [Задолженность просроченная, руб.], 
	     sum([Резерв на конец периода, руб.]) 			as [Резерв на конец периода, руб.],
	     rangesum(sum([Резерв на конец периода, руб.]), sum([Задолженность просроченная, руб.]),0) as [КПД. Резерв]
	Resident КК
	Group By
		 ПризнакДанные, 
	     [Контрагент ИНН], 
	     [Договор Номер], 
	     Дата, 
	     [Контрагент Наименование], 
	     [ДО Наименование], 
		 [Подразделение Наименование], 
	     [Задолженность Вид], 
	     [Бухгалтерский счет], 
	     Комментарии;
	
	DROP Table КК;
	STORE КК_TMP into [$(vDataTier3)\Дашборд ВОК\КПД_Итог.qvd];
	DROP Table КК_TMP;

ENDSUB
///$tab CALLs
CALL MapTBLs
CALL МТР_ВовлечениеГод
CALL КЗ_Факторинг
CALL КПД

