///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);

///$tab MapTBLs
SUB MapTBLs

	НаличиеБГ:
	Mapping
	LOAD * Inline[
	Поле1, 	Поле2
	да, 	Да
	ДА,		Да
	нет,	Нет
	НЕТ,	Нет
	];
	
	[ДО_кратко_Атлас]:
	Mapping	
	LOAD Distinct
		Наименование	as ЮЛ,
	    [ДО Кратко] 	as ДО
	FROM
		[$(vDataTier1)\Excel\Контроль БДДС\Справочники\ДО_кратко_Атлас.qvd] (qvd);
		
	//******************************************************************  ДО
	ДО_map_TMP:
	LOAD Distinct     
	     [Наименование],
	     [ДО Кратко]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd);
	
	Concatenate (ДО_map_TMP)
	LOAD Distinct     
	     [ДО Атлас] as [Наименование],
	     [ДО Кратко]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where [ДО Атлас]<>'';
	
	Concatenate (ДО_map_TMP)
	LOAD Distinct     
	     [ДО Атлас (2)] as [Наименование],
	     [ДО Кратко]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where [ДО Атлас (2)]<>'';
	
	Concatenate (ДО_map_TMP)
	LOAD Distinct     
	     [ДО Атлас (3)] as [Наименование],
	     [ДО Кратко]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where [ДО Атлас (3)]<>'';
	
	ДО_map:
	Mapping
	LOAD      
	     [Наименование] as f1,
	     [ДО Кратко]	as f2
	Resident ДО_map_TMP;
	DROP Table ДО_map_TMP;
	
	Сценарии_Атлас:
	//каждый раз называются в Атлас по-разному, приходится мэпить вручную
	Mapping
	LOAD * INLINE [
    Атлас, 								Эталон
    Авансы 2+10 2024 (с НДС),			2024_2+10
    Авансы 6+6 2024 (с НДС),			2024_6+6
    Авансы 8+4 2024 и БП 2025 (с НДС),	2024_8+4
	];
		
ENDSUB

///$tab Main 7
//идет соединение ексель с историческими данными и КЛАД с новыми данными
SUB Transform_АвансыПрогноз

	//EXCEL прогнозы включая 2+10  2024. его надо исключить
	АвансыПрогноз_ВыплатаПогашениеОбороты:
	LOAD 
		 Сценарий, 
	     Год, 
	     ApplyMap('ДО_map',[Наименование ДО], [Наименование ДО]) 			as [Наименование ДО],
	     [Наименование ДО] 														as [ДО Наименование Исходное], 
	     if(WildMatch([САРЕХ/OPEX], 'САРЕХ',  'CAPEX'), 'САРЕХ', [САРЕХ/OPEX])	as [САРЕХ/OPEX],
	     [Наименование КП (если применимо)], 
	     [Наименование ПО], 
	     ИНН, 
	     [Статус контрактования], 
	     if([Номер договора (если применимо)] like '*7282/02 от 09.10.2020*', '7282/02 от 09.10.2020 года', text(LTrim([Номер договора (если применимо)])))	
	     																		as [Номер договора],
	     [Срок полного погашения аванса], 
	     ApplyMap('НаличиеБГ', [Наличие БГ], 'Не указано')						as [Наличие БГ], 
	     [Иное обеспечение], 
		 [Категория аванса],
	     [Тип аванса], 
	     Обоснование, 
	     [Сумма авансов, планируемых к выдаче в текущем году, руб.], 
	     [Размер погашения до конца года по текущему прогнозу, руб.], 
	     date(DayStart(MonthEnd(Дата))) 										as Дата
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\Excel\АвансыПрогноз_ВыплатаПогашениеОбороты.qvd]
		(qvd)
	Where 
		Год=2024 and Сценарий='0+12';


	//временное решение, выгурзка в ексель
	Concatenate  (АвансыПрогноз_ВыплатаПогашениеОбороты)
	LOAD 
		 Сценарий, 
		 Год, 
	     if([ДО Наименование Исходное]='ОАО Славнефть-Мегионнефтегаз, ОАО Славнефть-Мегионнефтегазгеология, ООО Славнефть-Нижневартовск, ОАО Соболь, ЗАО Обьнефтегеология, ОАО Обьн',
	     	if([Операционная единица (ОЕ)]='ОЕ СН-Мегионнефтегаз', 	'Мегион',
	     	if([Операционная единица (ОЕ)]='ОЕ МУБР', 				'МУБР')),
	     	ApplyMap('ДО_map',[Наименование ДО], [Наименование ДО]) )			as [Наименование ДО],

     	
	     [ДО Наименование Исходное], 
	     [САРЕХ/OPEX], 
	     [Наименование КП (если применимо)], 
	     [Наименование ПО], 
	     ИНН, 
	     [Статус контрактования], 
	     [Номер договора], 
	     [Срок полного погашения аванса], 
	     [Наличие БГ], 
	     [Иное обеспечение], 
	     [Категория аванса], 
	     [Тип аванса], 
	     Обоснование, 
	     Признак,      
	     [Сумма авансов, планируемых к выдаче в текущем году, руб.], 
	     [Размер погашения до конца года по текущему прогнозу, руб.], 
	     Дата
	FROM
		[$(vDataTier1)\Excel\Дашборд ВОК\Атлас_Выгрузка_Ексель.qvd]
		(qvd);
	
	

t2:
	LOAD Distinct
		Дата,
		Год
	Resident АвансыПрогноз_ВыплатаПогашениеОбороты;
	
	Join  (t2)
	LOAD 
		Дата as Дата1,
		Год
	Resident t2;

Join (АвансыПрогноз_ВыплатаПогашениеОбороты)
LOAD * Resident t2;
DROP Table t2;
	
	NoConcatenate
	t4:
	LOAD 
		 Сценарий, 
		 Год, 
	     [Наименование ДО], 
	     [ДО Наименование Исходное], 
	     [САРЕХ/OPEX], 
	     [Наименование КП (если применимо)], 
	     [Наименование ПО], 
	     ИНН, 
	     [Статус контрактования], 
	     [Номер договора], 
	     [Срок полного погашения аванса], 
	     [Наличие БГ], 
	     [Иное обеспечение], 
	     [Категория аванса], 
	     [Тип аванса], 
	     Обоснование, 
	     Признак,  
	     if(Дата1=Дата, [Сумма авансов, планируемых к выдаче в текущем году, руб.],0.1) as [Сумма авансов, планируемых к выдаче в текущем году, руб.], 
	     if(Дата1=Дата, [Размер погашения до конца года по текущему прогнозу, руб.], 0.1) as [Размер погашения до конца года по текущему прогнозу, руб.], 
//	     Дата,
	     Дата1 as Дата
	  Resident АвансыПрогноз_ВыплатаПогашениеОбороты
	  ;  
	  DROP Table АвансыПрогноз_ВыплатаПогашениеОбороты;
	
	STORE t4 into $(vDataTier2)\FactTables\Дашборд ВОК\Excel\АвансыПрогноз_ВыплатаПогашениеОбороты_Результат.qvd;
	
ENDSUB

///$tab СценарииФактЭталон
SUB СценарииФактЭталон
	
	FULL_SCN:
	load * inline [
	SCN_PER, 	Порядок
	0+12,		1
	1+11,		2
	2+10,		3
	3+9,		4
	4+8,		5
	5+7,		6
	6+6,		7
	7+5,		8
	8+4,		9
	9+3,		10
	10+2,		11
	11+1,		12
	];


	Mapping
	порядок_сценарий:
	LOAD
		SCN_PER,
		Порядок
	Resident FULL_SCN;

	Join (FULL_SCN)	
	Сценарии_Авансы_Excel:
	LOAD Distinct
		 Сценарий as Сценарий_факт, 
	     Год,
	     ApplyMap('порядок_сценарий', Сценарий) as Порядок_факт
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\Excel\АвансыПрогноз_ВыплатаПогашениеОбороты_Результат.qvd]
		(qvd);

	NoConcatenate
	t1:
	LOAD
		Год, 
		Сценарий_факт 	as [Сценарий факт],
		Порядок_факт	as [Порядок Факт],
		SCN_PER 		as [Сценарий Эталон],
		Порядок			as [Порядок Эталон]
	Resident
		FULL_SCN
	Where
		Порядок>=Порядок_факт;
	
	DROP Table FULL_SCN;
	
	Inner Join (t1)
	LOAD
		Год, 
		max([Порядок Факт]) as [Порядок Факт],
		[Сценарий Эталон],
		[Порядок Эталон]
	Resident 
		t1
	Group By
		Год, 
		[Сценарий Эталон],
		[Порядок Эталон];
	
	STORE t1 INTO [$(vDataTier2)\FactTables\Дашборд ВОК\Excel\АвансыПрогноз_СценарииФактЭталон.qvd];

ENDSUB
///$tab CALLs
CALL MapTBLs
CAll Transform_АвансыПрогноз
CALL СценарииФактЭталон
