///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);

///$tab ServiceTBLs
SUB ServiceTBLs	
	
	В_Периметре_ВОК:
	LOAD Distinct     
	     [ДО Кратко] as В_Периметре_ВОК
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.ВОК]=1; //только для вкладки ВОК
	
	СписокДоговоров_НулевоеСальдо:	
	LOAD * Inline[
	СписокДоговоров_НулевоеСальдо
	ННГ-22/07000/00214/Р
	ННГ-22/07000/00211/Р		
	ННГ-22/07000/00213/Р
	ННГ-22/07000/00212/Р
	];
	
ENDSUB
///$tab MapTBLs
SUB MapTBLs
	
	ПорядокОтчетности_Сортировка:
	Mapping
	LOAD 
	     Значение, 
	     (Порядок-1) as Порядок
	FROM
		[$(vDataTier1)\Excel\Контроль БДДС\Справочники\Сценарии.qvd]
		(qvd);
		
	Контрагент_Наименование:
	Mapping
	Load Distinct
		Text(LTrim([Контрагент ИНН])) 												as [АвансыПрогноз.ИНН],
		MaxString([Контрагент Наименование])										as [АвансыПрогноз.Наименование ПО]
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
		(qvd)
	Where 
		not IsNull([Контрагент ИНН])  and  [Контрагент ИНН]<>''
	Group By 
		Text(LTrim([Контрагент ИНН]));	
	
	Категория_Аванса:
	//всё остальное, что здесь не указано - относить в Прочие
	Mapping
	LOAD * INLINE [
    Тип аванса, 							Категория аванса
    АВ МТР капитального характера, 			"МТР, мобилизация"
    АВ МТР по операционной деятельности, 	"МТР, мобилизация"
    АВ по ПИР/СМР/НТН, 						ПИР/СМР
    прочие,									Прочие
	];
	
	НаличиеБГ:
	Mapping
	LOAD * Inline[
	Поле1, 	Поле2
	да, 	Да
	ДА,		Да
	нет,	Нет
	НЕТ,	Нет
	];
	

	
ENDSUB

///$tab Excel
//сбор авансов БОЛЬШЕ 50 млн с датой погашения в следующих годах
SUB Excel	
	
	Данные:
	LOAD
		*,
		[ДО Наименование Исходное]&'_'&ИНН&'_'&[Номер договора] as KEY;
	LOAD
		*,
		if(ИНН_='7838112072',  'ИНН 22', if(ИНН_='7813647735',  'ИНН 51',ИНН_)) as ИНН,
		if(Exists(В_Периметре_ВОК, [ДО Наименование Исходное]),[ДО Наименование Исходное], Null()) 								as [Наименование ДО], //для периметра ВОК
		if(not Exists(В_Периметре_ВОК, [ДО Наименование Исходное]), [ДО Наименование Исходное]&' (вне ВОК)', [ДО Наименование Исходное]) 	as [Наименование ДО Таблица] //все
		;
	LOAD 		     		
	     [Наименование ДО] 													as [ДО Наименование Исходное],
	     [ДО Наименование Исходное] 										as [ДО Наименование Исходное Атлас],  //Исходное из Атласа
	     sum([Сумма авансов, планируемых к выдаче в текущем году, руб.]) 	as [Сумма авансов, планируемых к выдаче в текущем году, руб.], 
	     sum([Размер погашения до конца года по текущему прогнозу, руб.]) 	as [Размер погашения до конца года по текущему прогнозу, руб.],	     

	     if(IsNull(ИНН),'Не указано', Text(ИНН)) 							as ИНН_,
	     Дата 																as Период,
	     if(text([Номер договора])='ОВ/К-39638-01-01', 'Договор лизинга ППА_БУ_2024_спец_1', text([Номер договора])) as [Номер договора], 
	     Сценарий,
//	     [САРЕХ/OPEX],
	     Год,
	     ApplyMap('ПорядокОтчетности_Сортировка', Сценарий) 		as Порядок,
	     Год*100+ ApplyMap('ПорядокОтчетности_Сортировка', Сценарий) as Поряддок_сУчетомГода
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\Excel\АвансыПрогноз_ВыплатаПогашениеОбороты_Результат.qvd]
		(qvd)
	Group By 
		[ДО Наименование Исходное],
		[Наименование ДО],
		if(IsNull(ИНН),'Не указано', Text(ИНН)),
		[Номер договора],
//		[САРЕХ/OPEX],
		Дата,
		Сценарий,
	    Год;		
	
	DROP Field ИНН_;
	
	ИсхСценарии_авансы:  
	LOAD Distinct 	
		Год&'_'&Сценарий 	as [АП.ИсходныйСценарий],
		Сценарий			as [АП.Сценарий],
		Год  				as [АП.Год],
		Порядок				as [АП.Порядок]
	Resident Данные;
	
	STORE ИсхСценарии_авансы into [$(vDataTier3)\Дашборд ВОК\Прогноз\Прогноз_Авансы_ИсходныеСценарииКЛАД.qvd];
	DROP Table ИсхСценарии_авансы;	
	
	
	//алгоритм поиска новых контрагентов+договор в следующем сценарии относительно предыдущего
	t1:
	LOAD Distinct
		KEY,
		Поряддок_сУчетомГода,
		AutoNumber(Поряддок_сУчетомГода)  as НомерСтроки
	Resident Данные
	Order By Поряддок_сУчетомГода asc;
	
	Join
	t2:
	LOAD Distinct
		KEY  					as KEY_2,
		НомерСтроки				as НомерСтроки_2,
		Поряддок_сУчетомГода	as Поряддок_сУчетомГода_2
	Resident t1;
	
	NoConcatenate
	t3:
	LOAD
		НомерСтроки_2,
		НомерСтроки,		
		KEY 					as KEY_1,
		Поряддок_сУчетомГода 	as Поряддок_сУчетомГода_1,
		KEY_2,
		Поряддок_сУчетомГода_2,	
		if(KEY<>KEY_2,1,0) 		as Признак_
	Resident t1
	Where 
		Поряддок_сУчетомГода_2>Поряддок_сУчетомГода
		and НомерСтроки_2-1=НомерСтроки
	Order By 
		Поряддок_сУчетомГода  asc, Поряддок_сУчетомГода_2 asc;
	DROP Table t1;
	
	t4:
	LOAD Distinct
		(НомерСтроки+1)&'_'&KEY_1 as KK
	Resident t3;
	
	Left Join(Данные)
	LOAD Distinct
		KEY_2 					as KEY,
		Поряддок_сУчетомГода_2 	as Поряддок_сУчетомГода,
		НомерСтроки_2,
		if(Exists(KK, (НомерСтроки_2)&'_'&KEY_2), 1,0) as KK_2
	Resident t3;
	
	DROP Table t4, t3;
//	DROP Field KEY;
	
ENDSUB
///$tab АРМ_КК_TMP
//подготовка всех данных из таблицы АРМ КК
SUB АРМ_КК_TMP
	
	АРМ_КК_TMP:	
	LOAD 
		 if(Month(Дата)=12, NULL(),
	     text((Num(Month(Дата))&'+'&Num(12-Month(Дата))))) 								as [Сценарий],
	     sum([Авансы Сумма на начало периода (без отрицательных сальдо), руб.])			as [Авансы Сумма на начало периода, руб.],	
	     sum([Авансы Сумма на конец периода (без отрицательных сальдо), руб.])			as [Авансы Сумма на конец периода, руб.],
	     sum([Авансы выплаченные (оборот Дт) (без отрицательных сальдо), руб.]) 		as [Авансы выплаченные (оборот Дт), руб.], 
     	 sum([Авансы погашенные (оборот Кт) (без отрицательных сальдо), руб.])			as [Авансы погашенные (оборот Кт), руб.], 
	     if(IsNull([Контрагент ИНН]),'Не указано', text([Контрагент ИНН]))				as ИНН,
	     if([Обеспечение признак наличия]=1,'Да','Нет') 								as [Наличие БГ],
	     Дата 																			as  Период,
	     Year(Дата) 																	as Год, 
	     if(text([Договор Номер])='ОВ/К-39638-01-01', 'Договор лизинга ППА_БУ_2024_спец_1', text(LTrim([Договор Номер]))) as [Номер договора], 
//	     ApplyMap('Категория_Аванса', [Задолженность Вид],'Прочие') 					as [Категория аванса],
//	     [Задолженность Тип] 															as [САРЕХ/OPEX],
	     if([Дата погашения]='01.01.0020', date('01.01.2025'),[Дата погашения])			as [Дата погашения],
	     if(IsNull([ДО Наименование]), 'Вне ВОК', 'ВОК')								as [Признак Вне периметра ВОК],
	     if(IsNull([ДО Наименование]), [ДО Наименование Исходное]&' ('&'вне ВОК)', [ДО Наименование Исходное]) as [Наименование ДО Таблица],
   	     [ДО Наименование] 																as [Наименование ДО],
	     [ДО Наименование Исходное]
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
		(qvd)
	Where 
		[Строка Тип]='Авансы'
		and Дата>=date(MakeDate('$(vYear_Dashboard)',  1, 1))
		and (not IsNull([ДО Наименование]) or WildMatch([ДО Наименование Исходное],'Ангара', 'Автоматизация', 'ННГГФ', 'Энергосистемы', 'Томскнефть ВНК', 'Гарант Сервис', 'SPD', 'ИТ Сервис'))		 //ННГГФ - ГПН-Ноябрьскнефтегазгеофизика
	Group By
		 [ДО Наименование],
		 Дата, 
		 [Договор Номер],
		 [Дата погашения],
	     [Контрагент ИНН],
	     [Обеспечение признак наличия],
//	     ApplyMap('Категория_Аванса', [Задолженность Вид],'Прочие'),
//	     [Задолженность Тип],
	     [ДО Наименование Исходное];


	Left Join (Данные)
	LOAD
	     sum([Авансы Сумма на начало периода, руб.]) as [Авансы Сумма на начало периода, руб.],	
	     sum([Авансы Сумма на конец периода, руб.])  as [Авансы Сумма на конец периода, руб.],
	     sum([Авансы выплаченные (оборот Дт), руб.]) as [Авансы выплаченные (оборот Дт), руб.], 
     	 sum([Авансы погашенные (оборот Кт), руб.])  as [Авансы погашенные (оборот Кт), руб.], 
	     ИНН,
	     Период,
//	     [САРЕХ/OPEX],
	     Год, 
	     [Номер договора],
	     [ДО Наименование Исходное]	     
	Resident АРМ_КК_TMP
	Group By 
		ИНН,
		Период,
//		[САРЕХ/OPEX],
	    Год, 
	    [Номер договора],
	    [ДО Наименование Исходное];

ENDSUB
///$tab ФормированиеПрогнозногоОстаткаНаНачГода
SUB ФормированиеПрогнозногоОстаткаНаНачГода
//формирование остатков начиная с 0+12 2025 года, 
//так как до 2024 года не было прогнозов по авансам, не собрать прогнозный остаток на начало

//	LET vToday 			= date('01.11.2024');
	LET vГодФакта	 	= Year('$(vToday)');
	LET vГодПрогноза	= Year('$(vToday)')+1;
	
	//генерация прогнозного остатка запускается только с сентября по декабрь
	//и собирает остаток АРМ КК на 31.08 + оборот сценария 8+4 сент-дек
	if Month('$(vToday)')>=9 THEN		

		Остатки_Авансы:	
		LOAD 
			'АРМ КК остаток' 						as Детали,
			[Авансы Сумма на конец периода, руб.]	as [Прогноз.Сумма],	
			ИНН,
			Период,		
			[Номер договора],
			[Наименование ДО Таблица],
			[Наименование ДО],
			[ДО Наименование Исходное]
		Resident АРМ_КК_TMP
		Where 
			Year(Период)='$(vГодФакта)'
//			and [Сценарий]=ApplyMap('ТаблицаСоответствияСценариев', Year(Период)&'_9+3')
			and Num(Month(Период))=8
			and Day(Период)=31;	
	
		//выплата и погашение по  8+4	
		Concatenate (Остатки_Авансы)
		LOAD 	 
			'Движения' 						as Детали,
			[ДО Наименование Исходное],
			[Наименование ДО],
			[Наименование ДО Таблица],
			ИНН, 
			[Номер договора], 
			[Сумма авансов, планируемых к выдаче в текущем году, руб.]  	as  [Прогноз.Сумма],
			[Сумма авансов, планируемых к выдаче в текущем году, руб.]  	as  [Прогноз.Сумма Выплата],
			-[Размер погашения до конца года по текущему прогнозу, руб.]  	as  [Прогноз.Сумма Погашение],  
			Период    
		Resident Данные
		Where
			Num(Month(Период))>8
			and Year(Период)='$(vГодФакта)'
			and ([Сумма авансов, планируемых к выдаче в текущем году, руб.]<>0	or	[Размер погашения до конца года по текущему прогнозу, руб.]<>0)
//			and [Сценарий]=ApplyMap('ТаблицаСоответствияСценариев', Year(Период)&'_8+4')
			and [Сценарий]='8+4';
				
		
		NoConcatenate
		ИТОГ:	
		LOAD 
			'0+12' 		  														as Сценарий,
			RangeSum(sum([Прогноз.Сумма]),sum([Прогноз.Сумма Погашение]),0)  	as [Авансы Сумма на начало периода, руб.],	
			ИНН,
			date(DayStart(MonthEnd(MakeDate((Year(Период)+1), 1, 1)))) 			as Дата,
			[Номер договора],
			[Наименование ДО Таблица],
			[Наименование ДО],
			[ДО Наименование Исходное]
		Resident Остатки_Авансы
		Group By 
			ИНН,
			date(DayStart(MonthEnd(MakeDate((Year(Период)+1), 1, 1)))),
			[Номер договора],
			[Наименование ДО Таблица],
			[Наименование ДО],
			[ДО Наименование Исходное];
				
		DROP Table Остатки_Авансы;

		STORE  ИТОГ into [$(vDataTier3)\Дашборд ВОК\Прогноз\Остатки на начало\ОстатокАвансы_прогноз_01_$(vГодПрогноза).qvd];
		DROP Table ИТОГ;
	
	ENDIF
//	DROP Table АРМ_КК_TMP;
							
ENDSUB
///$tab НаНачалоГода_0_12
SUB НаНачалоГода_0_12
	
	//добавляем  прогнозные остатки на начало года для  сценария 0+12 каждого года
	TMP:
	LOAD 	 
	     0 as Порядок,
	     Year(Дата)*100 as Поряддок_сУчетомГода,
	     Сценарий,
	     date(DayStart(MonthEnd(Дата))) 				as Период,
	     Year(Дата) 									as Год,	
	     
	     sum(if(Exists(СписокДоговоров_НулевоеСальдо, [Номер договора]) and Year(Дата)=2025, 0, [Авансы Сумма на начало периода, руб.])) 	as [Авансы Сумма на начало периода ПРОГНОЗ, руб.],	    
	     text(ИНН) 										as ИНН,  
	     if(text([Номер договора])='ОВ/К-39638-01-01', 'Договор лизинга ППА_БУ_2024_спец_1', text([Номер договора])) as [Номер договора], 
//	     [САРЕХ/OPEX], 
	     [ДО Наименование Исходное],
	     [Наименование ДО Таблица],
	     [ДО Наименование Исходное] 										as [ДО Наименование Исходное Атлас],  //Исходное из Атласа
		 [Наименование ДО]	     
	FROM
		[$(vDataTier3)\Дашборд ВОК\Прогноз\Остатки на начало\ОстатокАвансы_прогноз_01_202*.qvd]
		(qvd)
	Where
		[Авансы Сумма на начало периода, руб.]<>0
	Group By 
		Сценарий,
		Дата,
		ИНН, 
		[Номер договора], 
//		[САРЕХ/OPEX], 
		[Наименование ДО Таблица],
		[Наименование ДО],
		[ДО Наименование Исходное];

    Concatenate (Данные)
	LOAD * Resident TMP
	Where Exists(KEY, [ДО Наименование Исходное]&'_'&ИНН&'_'&[Номер договора]); //только те, кто есть в планах Атлас
	DROP Table TMP;
	DROP Table СписокДоговоров_НулевоеСальдо;

ENDSUB 

///$tab Итог
SUB итог
	
	Авансы_Факт_Прогноз:
	LOAD
		*,
		if(fabs([Авансы выплаченные (оборот Дт), руб. ФАКТ]-Выплата_ДляДельты)<2,0,Round([Авансы выплаченные (оборот Дт), руб. ФАКТ]-Выплата_ДляДельты))  as [АвансыПрогноз.Выплата Дельта],
		if(fabs(Погашение_ДляДельты-[Авансы погашенные (оборот Кт), руб. ФАКТ])<2,0, Round(Погашение_ДляДельты-[Авансы погашенные (оборот Кт), руб. ФАКТ])) as [АвансыПрогноз.Погашение Дельта];	
	LOAD
		 1 as [Признак движение],
		 Сценарий  as [Сценарий Эталон],
		 Сценарий,
//		 [САРЕХ/OPEX]  as  [АвансыПрогноз.САРЕХ/OPEX],
		 Год,
		 [ДО Наименование Исходное],
	     [Наименование ДО],
		 [Наименование ДО Таблица] 											as [АвансыПрогноз.Наименование ДО.Таблица],
		 if([Наименование ДО Таблица] like '*вне ВОК*', 0,1) 				as [АвансыПрогноз.Признак В периметре ВОК],
		 Период																as [АвансыПрогноз.Дата],		 
		 'Excel'	 														as [АвансыПрогноз.Источник],	     
	     ИНН	 															as [АвансыПрогноз.ИНН], 
	      ApplyMap('Контрагент_Наименование', ИНН,  'Не указано')			as [АвансыПрогноз.Наименование ПО],
	     [Номер договора] 													as [АвансыПрогноз.Номер договора], 
	     sum([Авансы выплаченные (оборот Дт), руб.])						as [Авансы выплаченные (оборот Дт), руб. ФАКТ],
	     sum([Авансы погашенные (оборот Кт), руб.])							as [Авансы погашенные (оборот Кт), руб. ФАКТ],	     
	     sum(if([Сумма авансов, планируемых к выдаче в текущем году, руб.]<10,0,[Сумма авансов, планируемых к выдаче в текущем году, руб.])) 	as Выплата,
	     Round(sum(if([Размер погашения до конца года по текущему прогнозу, руб.]<10,0,[Размер погашения до конца года по текущему прогнозу, руб.]))) 	as Погашение,
	     
	     //для дельты
	     sum(if([Сумма авансов, планируемых к выдаче в текущем году, руб.]<10 or [Номер договора]='Не законтрактован',0,[Сумма авансов, планируемых к выдаче в текущем году, руб.])) 	as Выплата_ДляДельты,
	     sum(if([Размер погашения до конца года по текущему прогнозу, руб.]<10 or [Номер договора]='Не законтрактован',0,[Размер погашения до конца года по текущему прогнозу, руб.])) 	as Погашение_ДляДельты,
	     
	     sum([Авансы Сумма на начало периода ПРОГНОЗ, руб.])																			as [Авансы Сумма на начало периода ПРОГНОЗ, руб.],	     
	     sum([Авансы Сумма на начало периода, руб.]) 																					as [Остаток на начало периода], //фактический 
	     if(ApplyMap('ПорядокОтчетности_Сортировка', [Сценарий])=Num(Month(Период)),  sum([Авансы Сумма на конец периода, руб.])	,0) as [Остаток на конец периода], 
	     sum([Авансы Сумма на конец периода, руб.]) 																					as [Остаток на конец периода Для таблицы отклонения], 
		 ApplyMap('ПорядокОтчетности_Сортировка', [Сценарий]) 																			as Порядок,
	     if(ApplyMap('ПорядокОтчетности_Сортировка', [Сценарий])>=Month(Период), 1,0) 													as [Признак наличия факта],
	     if(KK_2=0, 'Новый в сценарии '&Сценарий&' '&Год, Null())  																		as [ПризнакНовыйДоговор]
	Resident 
		Данные
	Group By
		Сценарий,
//		[САРЕХ/OPEX],
		Год,
		[Наименование ДО Таблица] ,
		Период,
		[ДО Наименование Исходное],
		[Наименование ДО],
		ИНН,
		KK_2,
		[Номер договора];
			
	DROP Table Данные;
	DROP Table В_Периметре_ВОК;	
	
	STORE Авансы_Факт_Прогноз into $(vDataTier3)\Дашборд ВОК\Прогноз\Прогноз_Авансы.qvd;

ENDSUB
///$tab ВыгрузкаАвансыДляДДС
SUB ВыгрузкаАвансыДляДДС
	
	Прогноз_авансы:
	LOAD 		     		
	     [Наименование ДО],
	     sum([Сумма авансов, планируемых к выдаче в текущем году, руб.]) 	as Выплата, 
	     sum([Размер погашения до конца года по текущему прогнозу, руб.]) 	as Погашение,	     
	     Дата			 													as АвансыПрогноз.Дата,	    
	     Сценарий 															as [Сценарий Эталон],
	     [САРЕХ/OPEX] 														as [АвансыПрогноз.САРЕХ/OPEX],
	     Сценарий,
	     Год
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\Excel\АвансыПрогноз_ВыплатаПогашениеОбороты_Результат.qvd]
		(qvd)
	Group By 
		[Наименование ДО],
		[САРЕХ/OPEX],
		Дата,
		Сценарий,
	    Год;		
	
	STORE Прогноз_авансы into [$(vDataTier3)\Дашборд ВОК\Прогноз\Прогноз_Авансы_ДляДДС.qvd];
	DROP Table Прогноз_авансы;

ENDSUB
///$tab Прогнозы
SUB Прогнозы
	
	//факты по сценариям с 1+11 по 11+1
	NoConcatenate
	[Прогноз Данные]:
	LOAD 
		*,
		if(ApplyMap('ПорядокОтчетности_Сортировка', [Прогноз.Сценарий])>=Month(Дата), 1,0) as [Признак наличия факта]
	Where not IsNull([Прогноз.Сценарий]);
	LOAD 
		 Сценарий 												as [Прогноз.Сценарий],
	     Year(AddMonths(Период,+1)) 							as Год,
	     date(DayStart(MonthEnd(AddMonths(Период,+1)))) 		as Дата,  
	     [ДО Наименование Исходное], 
	     [Наименование ДО] 										as [ДО Наименование],
	     sum([Авансы Сумма на конец периода, руб.])				as Прогноз.Сумма,
	     if([Наименование ДО Таблица] like '*вне ВОК*', 0,1) 	as [АвансыПрогноз.Признак В периметре ВОК]
	Resident
		АРМ_КК_TMP
	Where
		not IsNull(Сценарий)
	Group By
		Сценарий,
		Период,
		[ДО Наименование Исходное], 
	    [Наименование ДО],
	    [Наименование ДО Таблица];
	
	DROP Table АРМ_КК_TMP;
	
	
	Concatenate ([Прогноз Данные])
	LOAD 
		 Сценарий 							as  [Прогноз.Сценарий],
	     Год,
	     АвансыПрогноз.Дата	 				as Дата,
	     [ДО Наименование Исходное],
	     [Наименование ДО] 					as [ДО Наименование],
	     sum(Round([Авансы Сумма на начало периода ПРОГНОЗ, руб.])) 				as Прогноз.Сумма,
	     0 									as [Признак наличия факта],
	     [АвансыПрогноз.Признак В периметре ВОК]
	Resident 
		Авансы_Факт_Прогноз
	Where 
		Сценарий='0+12'
	Group By 
		Сценарий, 
		[Наименование ДО],
		[ДО Наименование Исходное], 
		АвансыПрогноз.Дата,
		Год,
		[АвансыПрогноз.Признак В периметре ВОК];
	
	
ENDSUB
///$tab ВсеПериоды
SUB ВсеПериоды

	Сценарии:
	LOAD 
		Год, 
	    [Сценарий Эталон] as [Прогноз.Сценарий], 
	    [Сценарий факт]
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\Excel\АвансыПрогноз_СценарииФактЭталон.qvd]
		(qvd);
	
	Left Join (Сценарии)
	[Прогноз Месяцы]:
	LOAD
		Год,
		Период as Дата
	FROM
		[$(vDataTier1)\Excel\Дашборд ВОК\Периоды.qvd](qvd);
	
	Left Join (Сценарии)
	LOAD Distinct [ДО Наименование], [ДО Наименование Исходное] Resident [Прогноз Данные];
	
	NoConcatenate
	Сценарии_:
	LOAD
		[ДО Наименование],
		[ДО Наименование Исходное],
		[Прогноз.Сценарий],
		[Сценарий факт],
		Дата,
		Год,
		if(ApplyMap('ПорядокОтчетности_Сортировка', [Прогноз.Сценарий])>=Month(Дата), 1,0) as [Признак наличия факта]
	Resident 
		Сценарии;
	DROP Table Сценарии;

ENDSUB




///$tab Авансы_Выплата_Погашение
SUB Авансы_Выплата_Погашение
	
	NoConcatenate
	t1:
	LOAD * Resident Сценарии_;
	
	Left Join (t1)
	LOAD
		[Наименование ДО] 			as [ДО Наименование],
		[ДО Наименование Исходное],  
		Сценарий 					as [Сценарий факт],  
		АвансыПрогноз.Дата	 		as Дата, 
		sum(Выплата) 				as [Прогноз.Сумма.Выплата],
		sum(Погашение) 				as [Прогноз.Сумма.Погашение],
		[АвансыПрогноз.Признак В периметре ВОК]
	Resident 
		Авансы_Факт_Прогноз
	Group by 
		[Наименование ДО], 
		[ДО Наименование Исходное], 
		Сценарий,  
		[Признак наличия факта],
		АвансыПрогноз.Дата,
		[АвансыПрогноз.Признак В периметре ВОК];
	
	DROP Table Авансы_Факт_Прогноз;
	DROP Field [Сценарий факт] From t1;
		
	Outer Join ([Прогноз Данные])
	LOAD * Resident t1;
	DROP Table t1, Сценарии_;
	
ENDSUB
///$tab генерацияпрогноза
sub генерацияпрогноза

	NoConcatenate
	t1:
	LOAD
	*,
	if([ДО Наименование Исходное]=Previous([ДО Наименование Исходное]) and [Прогноз.Сценарий]=Previous([Прогноз.Сценарий]) and Год=Previous(Год),
			Rangesum(peek('Прогноз'), [Прогноз.Сумма.Выплата],-[Прогноз.Сумма.Погашение]),
			Rangesum(0,	   			  [Прогноз.Сумма],[Прогноз.Сумма.Выплата],-[Прогноз.Сумма.Погашение])) as Прогноз;
	LOAD
		[Прогноз.Сценарий],
		[ДО Наименование Исходное],  
		[ДО Наименование],
		Год,
		Дата,  
		[Прогноз.Сумма],
		[Признак наличия факта],
		[АвансыПрогноз.Признак В периметре ВОК],
		RangeSum(0, [Прогноз.Сумма.Погашение]) as [Прогноз.Сумма.Погашение],
		RangeSum(0, [Прогноз.Сумма.Выплата]) as [Прогноз.Сумма.Выплата]
	Resident 
		[Прогноз Данные]
	Where 
		[Признак наличия факта]=0
	Order By
		[ДО Наименование Исходное],
		[ДО Наименование], 
		Год,
		[Прогноз.Сценарий],
		Дата asc;

	DROP Table [Прогноз Данные];

	NoConcatenate
	Прогноз:
	LOAD 
		[Прогноз.Сценарий],
		[АвансыПрогноз.Признак В периметре ВОК],
		[ДО Наименование],  
		Год,
		Дата,  
		Прогноз
	Resident t1 
	Where 
		Прогноз<>0
		and not IsNull([ДО Наименование])
		and [АвансыПрогноз.Признак В периметре ВОК]=1;

	STORE Прогноз into $(vDataTier3)\Дашборд ВОК\Прогноз\Прогноз_Авансы_СВОД_ВОК.qvd;
	DROP Table Прогноз;	
	
ENDSUB
///$tab CALLs
CALL ServiceTBLs
CALL MapTBLs
CALL Excel
CALL АРМ_КК_TMP

CALL ФормированиеПрогнозногоОстаткаНаНачГода

call НаНачалоГода_0_12

CALL Итог
CALL ВыгрузкаАвансыДляДДС


CALL Прогнозы
CALL ВсеПериоды
CALL Авансы_Выплата_Погашение
CALL генерацияпрогноза