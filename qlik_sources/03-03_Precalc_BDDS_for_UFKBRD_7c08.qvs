///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);
///$tab MapTBLs
SUB MapTBLs

	ДО_ВОК:
	LOAD distinct
		[ДО Кратко] as ДО_ВОК
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.ВОК]=1; //только для вкладки ВОК

	map_ТипДО:
	Mapping
	LOAD distinct
		[ДО Кратко],
		[ДО/СП]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.БДДС]=1; //только для вкладки БДДС
	
	map_ТипДО_СервисыГРР:
	Mapping
	LOAD distinct
		[ДО Кратко],
		[ТИП ДО]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.БДДС]=1; //только для вкладки БДДС

	//здесь только ДО для ВОК, для БДДС нужен новый список ДО (полный)
	ДО_БДДС:
	LOAD  Distinct
		[ДО Кратко] as [ДО кратко БДДС]  
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.БДДС]=1; //только для вкладки БДДС
	
ENDSUB

///$tab Data
//БЛОК ЗАГРУЗКИ ДАННЫХ БДДС
SUB Data
	
	Порядок:
	Mapping LOAD Порядок, Значение From [$(vDataTier1)\Excel\Контроль БДДС\Справочники\Сценарии.qvd] (qvd);
	
	LET vМесяц =  Num(Month('$(vToday)'));
	
	МаксПериод:
	LOAD * Where МаксПериод='$(vМесяц)';
	LOAD
		([Порядок отчетности]) 					 		as МаксПериод,
		ApplyMap('Порядок', ([Порядок отчетности])) 	as Порядок
	FROM
		[$(vDataTier3)\Контроль БДДС\Дашборд Контроль БДДС\Данные.qvd] (qvd)
	Where
		Год=Year('$(vToday)');
		
		
	LET vПериод = peek('Порядок',0,'МаксПериод');	
	DROP Table МаксПериод;
	
	Data_ЛВФ:
	LOAD 
		'Долг на начало года' 											as [ДДС Признак],
		ДО, 
		Год,
		[Отчетный период], 
		[Долг на начало года RUB] 										as [ДДС Сумма]
	FROM
		[$(vDataTier3)\Контроль БДДС\Внутригрупповые займы\LVF2023.qvd]
		(qvd)
	Where 
		[Отчетный период]='$(vПериод)' and Год=Year('$(vToday)') and
		exists([ДО кратко БДДС], ДО);


	НалоговаяНеэф:
	LOAD 
		'Налоговая неэффективность' 									as [ДДС Признак],
		ДО, 
		[Налоговая неэффективность] 									as [ДДС Сумма],
		Год																as [ДДС ЛВФ Год]
	FROM
		[$(vDataTier3)\Контроль БДДС\Внутригрупповые займы\НалоговаяНеэффективность*.qvd]
		(qvd)
	Where 
		exists([ДО кратко БДДС], ДО);
	
	NoConcatenate
	Data_Лимит:
	LOAD
		'Лимит' 						 as [ДДС Признак],
		ДО, 
		date(DayStart(MonthEnd(Период))) as [ДДС Период],
		sum(Лимит)				 		 as [ДДС Сумма],
		[Отчетный период]
	FROM
		[$(vDataTier3)\Контроль БДДС\Лимиты\Лимиты.qvd]
		(qvd)
	Where
		[Порядок статей]=8 and
		[Отчетный период]='$(vПериод)' and Year(Период)=Year('$(vToday)') and
		exists([ДО кратко БДДС], ДО)
	Group By
		[ДО],
		[Период],
		[Отчетный период];
		
	Data:
	LOAD 
		*,
		ApplyMap('map_ТипДО', ДО, Null()) 			 as [ДО/СП],
		ApplyMap('map_ТипДО_СервисыГРР', ДО, Null()) as [ДО Тип];
	LOAD 
		[признак Блок], 
		[Порядок статей], 
		ДО, 
		ДО_Full, 
		[Отчетный период], 
		[Порядок отчетности], 
		[Порядок сортировки периода], 
		Год, 
		Date(Floor(MonthEnd(Период))) as [ДДС Период], 
		Месяц, 
		Round([Сумма план-факт], 0.01) as [Сумма план-факт], 
		Группа, 
		Аналитика, 
		Группа1, 
		Группа2, 
		Группа3,
		[Реализация третьим лицам], 
		[Признак наличия факта], 
		%KEY_LVF, 
		%KEY, 
		Round(План, 0.01) as План,
		if(ДО<>'БРД',ДО) 				 as ДО_New,
		if(IsNull(ДО_Full), ДО, ДО_Full) as ДО_Full_SA
	FROM
		[$(vDataTier3)\Контроль БДДС\Дашборд Контроль БДДС\Данные.qvd] (qvd)
	WHERE 
		(
			[Отчетный период]='$(vПериод)' and Год=Year('$(vToday)') and
			(exists([ДО кратко БДДС], ДО) or ДО='БРД')
		);	
	
	drop table ДО_БДДС;

ENDSUB

///$tab ДДС_СборВкладкиБДДС_ВОК
SUB ДДС_СборВкладкиБДДС_ВОК

	//Показатель *ЭФФЕКТ ПРИМЕНЕНИЯ СХЕМ ФАКТОРИНГА МТО*
	NoConcatenate
	Data_TMP:
	LOAD
		'Эффект применения схем факторинга МТО' 	as [ДДС Признак],
		Round(sum([Сумма план-факт])/1.2*(-1), 0.01)as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]=13 and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ЭФФЕКТ ПРИМЕНЕНИЯ СХЕМ ФАКТОРИНГА ПО ИДП*
	Concatenate (Data_TMP)
	LOAD
		'Эффект применения схем факторинга по ИДП'  as [ДДС Признак],
		Round(sum([Сумма план-факт])/1.2*(-1), 0.01)	as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]=14 and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ФАКТ* для расчета KPI отклонения
	Concatenate (Data_TMP)
	LOAD
		'Факт' 					as [ДДС Признак],
		sum([Сумма план-факт]) 	as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]>=2 and [Порядок статей]<=5 and
		[Признак наличия факта]=1 and [Реализация третьим лицам]='Да'// and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ПЛАН* для расчета KPI отклонения
	Concatenate (Data_TMP)
	LOAD
		'План' 		as [ДДС Признак],
		sum(План) 	as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]>=2 and [Порядок статей]<=5 and
		[Признак наличия факта]=1 and [Реализация третьим лицам]='Да'// and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *СДП* для расчета KPI СДП
	Concatenate (Data_TMP)
	LOAD
		'СДП' 					as [ДДС Признак],
		sum([Сумма план-факт]) 	as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]>=2 and [Порядок статей]<=3 
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ДОБЫВАЮЩИЕ ДО*
	Concatenate (Data_TMP)
	LOAD
		'Добывающие ДО' 			 as [ДДС Признак],
		fabs(sum([Сумма план-факт])) as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		Группа1='Платежи по инвестиционной деятельности' and [ДО Тип]='Добыча' and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *СЕРВИСЫ*
	Concatenate (Data_TMP)
	LOAD
		'Сервисы' 				as [ДДС Признак],
		sum([Сумма план-факт]) 	as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[ДО Тип]='Сервисы' and
		[Порядок статей]>=2 and [Порядок статей]<=3 and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ДО ГРР*
	Concatenate (Data_TMP)
	LOAD
		'ДО ГРР' 																as [ДДС Признак],
		sum(if([Порядок статей]=10, [Сумма план-факт], [Сумма план-факт]*(-1))) as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[ДО Тип]='ГРР' and
		[Порядок статей]>=10 and [Порядок статей]<=11 and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *Долг на начало года*. Испольузется также отбор по ГРР для графика ГРР
	Concatenate (Data_TMP)
	LOAD 
		[ДДС Признак],
		[ДО], 
		[ДДС Сумма],
		[Отчетный период],
		Год as [ДДС ЛВФ Год]	
	Resident
		Data_ЛВФ
	Where
		ДО<>'БРД';

	//Показатель налоговая неэф-ть*. Испольузется также отбор по ГРР для графика ГРР
	Concatenate (Data_TMP)
	LOAD
		[ДДС Признак],
		[ДО],
		[ДДС ЛВФ Год],
		[ДДС Сумма]
	Resident
		НалоговаяНеэф;

	Drop Table НалоговаяНеэф;	

	//Показатель *ПОСТУПЛЕНИЕ* для графика займов
	Concatenate (Data_TMP)
	LOAD
		'Поступление' 			as [ДДС Признак],
		sum([Сумма план-факт]) 	as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		Year([ДДС Период]) as [ДДС ЛВФ Год],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		Группа ='Финансовый Денежный Поток (ФДП)' and
		Группа2='Поступления займов (ВГО)' and
		Группа3='ОЕ Газпром нефть_КЦ (к)'
//		[Порядок статей]=10 
and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ПОГАШЕНИЕ* для графика займов
	Concatenate (Data_TMP)
	LOAD
		'Погашение' 			as [ДДС Признак],
		sum([Сумма план-факт]) 	as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		Year([ДДС Период]) as [ДДС ЛВФ Год],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		Группа ='Финансовый Денежный Поток (ФДП)' and
		Группа2='Погашение займов (ВГО)' and
		Группа3='ОЕ Газпром нефть_КЦ (к)' 
//		[Порядок статей]=11 
		and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ОДП план* для графика
	Concatenate (Data_TMP)
	LOAD
		'ОДП План'  as [ДДС Признак],
		(sum(План)) as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]=2// and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ОДП факт* для графика
	Concatenate (Data_TMP)
	LOAD
		'ОДП Факт' 				 as [ДДС Признак],
		(sum([Сумма план-факт])) as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]=2 and [Признак наличия факта]=1// and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ИДП план* для графика
	Concatenate (Data_TMP)
	LOAD
		'ИДП План'  as [ДДС Признак],
		(sum(План)) as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]=3// and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ИДП факт* для графика
	Concatenate (Data_TMP)
	LOAD
		'ИДП Факт' 				 as [ДДС Признак],
		(sum([Сумма план-факт])) as [ДДС Сумма],
		[ДО Тип],
		[ДО],
		[ДДС Период],		
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		[Порядок статей]=3 and [Признак наличия факта]=1// and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ПЛАТЕЖИ ПО ИД* для графика
	Concatenate (Data_TMP)
	LOAD
		'Платежи по ИД' as [ДДС Признак],
		[ДО Тип],
		[ДО],
		[ДДС Период],
		(Round(sum(if([Порядок статей]=8 or [Порядок статей]=9, ([Сумма план-факт])/1.2,
		([Сумма план-факт]*(-1)))), 0.01)) as [ДДС Сумма],
		Месяц,
		[Отчетный период]
	Resident 
		Data
	Where
		([Порядок статей]=8 or [Порядок статей]=9 or [Порядок статей]=15) and ДО<>'БРД'
	Group By
		[ДО Тип],
		[ДО],
		[ДДС Период],
		Месяц,
		[Отчетный период];

	//Показатель *ЛИМИТ* для графика
	Concatenate (Data_TMP)
	LOAD
		[ДДС Признак],
		[ДО], 
		[ДДС Период],
		Year([ДДС Период]) as [ДДС ЛВФ Год],
		[ДДС Сумма],
		[Отчетный период]
	Resident
		Data_Лимит
	Where
		ДО<>'БРД';	

	DROP TABLE Data, Data_Лимит, Data_ЛВФ;
	STORE Data_TMP INTO [$(vDataTier3)\Дашборд ВОК\Лист_2 БДДС\Данные_БДДС_Data.qvd] (qvd);

ENDSUB

///$tab ДДС_КПЭ
SUB ДДС_КПЭ
	
	NoConcatenate
	ДДС_КПЭ:
	LOAD
	*
	Where [ДДС.Сумма]<>0;
	LOAD
		sum([ДДС Сумма])as [ДДС.Сумма],
		ДО 				as [ДО Наименование],
		ДО				as [ДО ДДС],
		[ДДС Признак] 	as [ДДС.Признак],
		[ДДС ЛВФ Год] 	as [ДДС.Год]
	Resident 
			Data_TMP
	Where 
		WildMatch([ДДС Признак], 'Долг на начало года', 'Поступление', 'Погашение', 'Налоговая неэффективность')
		and Exists(ДО_ВОК, ДО)
	Group By									
		ДО,
		[ДДС Признак],
		[ДДС ЛВФ Год];
	
	//DROP Table Data;
	DROP Table Data_TMP;
	store ДДС_КПЭ into [$(vDataTier3)\Дашборд ВОК\Лист_0 Общий\ДДС_КПЭ.qvd] (qvd);
//	DROP Table ДДС_КПЭ;

ENDSUB


///$tab ДДС_ДляВОК
SUB ДДС_ДляВОК

	//Сбор исходящих платежей для расчета оборачиваемости КЗ на первом листе ВОК
	//Собирается только по фактическим данным
	ДДС_ДляВОК:
	LOAD 
		date(DayStart(MonthEnd(Период))) 	as Дата, 
		ДО								 	as [ДО Наименование], //здесь будут уже краткие названия. мэппинг не нужн
		fabs(sum([Сумма план-факт])) 		as Сумма, 
		Группа2 							as [БДДС Группа2]
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\SAP\Форма_БДДС Корректировки только по ДО.qvd]
		(qvd)
	Where 
		WildMatch(Группа2,  'Транспортные за нефть, н/пр, газ (труба, ж/д, авто, вода) (3и лица)',
							'Приобретение нефти, н/п, газа (3и лица)',
							'Энерго и теплообеспечение производства (3и лица)',
							'Прочие платежи (3и лица)',
							'Платежи по Инвестиционной Программе с учетом отсрочек по факторингу (3и лица)')
		 					 and
		 exists(ДО_ВОК, ДО)
	Group by
		Период,
		ДО,
		Группа2;
	
	STORE ДДС_ДляВОК INTO [$(vDataTier3)\Дашборд ВОК\Лист_2 БДДС\ДДС_ДляВОК.qvd] (qvd);
	DROP Table ДДС_ДляВОК;

ENDSUB

///$tab СПО
SUB СПО

	//Поиск максимального сценария за текущий год - всегда одно значение
	Сценарии:
	LOAD Distinct 
		Год,
		MaxString(scenario) as scenario
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
		(qvd)
	Where 
		Год=Year('$(vToday)')	
	Group By
		Год;

	//“EBITDA для целей УПЦ” берется из СПО – такая строка есть (accounts_ALIAS поле)
	Ebitda_СПО:
	LOAD  
		Год,
		scenario,
		entity_ALIAS2 					as ДО, 
		date(DayStart(MonthEnd(Дата)))  as Дата, 
		round(sum(Данные),0.01) 		as Данные
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
		(qvd)
	Where 
		account_ALIAS='EBITDA для целей УПЦ'
		and counterparty_ALIAS <> 'Итого контрагенты (к)'
		and counterparty_ALIAS <> 'Итого контрагенты (функц) (к)'
		and exists(ДО_ВОК, entity_ALIAS2)
	Group By
		entity_ALIAS2,
		Дата,
		Год,
		scenario;

	Inner Join (Ebitda_СПО)
	LOAD
		*
	Resident 
		Сценарии;
	
	STORE Ebitda_СПО into $(vDataTier3)\Дашборд ВОК\Прогноз\Ebitda_СПО.qvd;
	DROP Table Ebitda_СПО;

	//Финансирование CAPEX берется из СПО по маске “Финансирование*”, кроме “Финансирование_Дивестиции (инв)”
	Финансирование_CAPEX:
	LOAD  
		Год,
		scenario,
		entity_ALIAS2 					as ДО, 
		date(DayStart(MonthEnd(Дата))) 	as Дата, 
		round(sum(Данные),0.01) 		as Данные
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
		(qvd)
	Where 
		WildMatch(account_ALIAS,'Финансирование*')
		and account_ALIAS<>'Финансирование_Дивестиции (инв)'
		and counterparty_ALIAS <> 'Итого контрагенты (к)'
		and counterparty_ALIAS <> 'Итого контрагенты (функц) (к)'
		and exists(ДО_ВОК, entity_ALIAS2)
	Group By
		entity_ALIAS2,
		Дата,
		Год,
		scenario;

	Inner Join (Финансирование_CAPEX)
	LOAD
		*
	Resident 
		Сценарии;
	
	STORE Финансирование_CAPEX into $(vDataTier3)\Дашборд ВОК\Прогноз\Финансирование_CAPEX.qvd;
	DROP Table Финансирование_CAPEX;

	//Уровень добычи берем из СПО из строки “Добыча УВ (с учётом ЖУВ), тыс.тнэ”
	Добыча:
	LOAD  
		Год,
		scenario,
		entity_ALIAS2 					as ДО, 
		date(DayStart(MonthEnd(Дата))) 	as Дата, 
		round(sum(Данные),0.01) 		as Данные
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
		(qvd)
	Where 
		account_ALIAS='Добыча УВ (с учётом ЖУВ), тыс.тнэ'
		and counterparty_ALIAS <> 'Итого контрагенты (к)'
		and counterparty_ALIAS <> 'Итого контрагенты (функц) (к)'
		and exists(ДО_ВОК, entity_ALIAS2)
	Group By
		entity_ALIAS2,
		Дата,
		Год,
		scenario;

	Inner Join (Добыча)
	LOAD
		*
	Resident 
		Сценарии;
	DROp table Сценарии, ДО_ВОК;
	
	STORE Добыча into $(vDataTier3)\Дашборд ВОК\Прогноз\Добыча.qvd;
	DROP Table Добыча;

ENDSUB


///$tab CALLs
CALL MapTBLs
CALL Data
CALL ДДС_СборВкладкиБДДС_ВОК
CALL ДДС_КПЭ
CALL ДДС_ДляВОК
CALL СПО

