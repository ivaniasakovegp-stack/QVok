///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);
///$tab ServiceTBLs
SUB ServiceTBLs

	ДО_Список:
	LOAD  Distinct
		[БЕ Код],
		[ДО Кратко]   as ДО_Список  
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.ВОК]=1; //только для вкладки ВОК	
	
	Вне_алгоритма:
	LOAD Distinct 
		[Строка PL]
	FROM
		[$(vDataTier1)\Excel\Контроль БДДС\Справочники\ALGORITM_DEPOS_SPO.qvd]
		(qvd)
	where 
		[Сдвиг данных] = 'вне алгоритма';
			
ENDSUB
///$tab MapTBLs
SUB MapTBLs

	ПорядокОтчетности_Сортировка:
	Mapping
	LOAD 
		Значение,
		Порядок-1 as  Порядок
	FROM [$(vDataTier1)\Excel\Контроль БДДС\Справочники\Сценарии.qvd] (qvd);

ENDSUB
///$tab ОстатокНаНачалоГода_0_12
SUB ОстатокНаНачалоГода_0_12

	if Month('$(vToday)')>=10 or Month('$(vToday)')=1 THEN	
		//этот скрипт должен запускать с октября по январь 
		
		if Month('$(vToday)')>=11 THEN
			SET vКоличество = 0;
		ELSE
			SET vКоличество = 1;
		ENDIF
	
	////ДЛЯ ОТЛАДКИ	
	//	LET vДатаОстаток 		= date('30.09.2023');
	//	LET vДата_НачалоГода	= date('01.01.2024');
		
		LET vДатаОстаток		= date(MakeDate(Year('$(vToday)')-'$(vКоличество)',   9, 30));
		LET vДата_НачалоГода	= date(MakeDate(Year('$(vToday)')-'$(vКоличество)'+1, 1, 1));
		
		LET vГОД				= Year('$(vДатаОстаток)');
		LET vГОД_НачалоГода		= Year('$(vДата_НачалоГода)');
	
		//остаток на 30.09. Далее по сценарию 9+3  набираются месяцы окт-дек
		Остаток_КЗ:
		LOAD 
		     Year(Дата) 														as Год,
		     [Строка Тип]														as [Прогноз.Признак],
		     'На начало окт '&Year(Дата)										as [Прогноз.Сценарий],
		     [ДО Наименование],  
		     date(DayStart(MonthEnd(Дата))) 									as Дата,  
		     sum([КЗ на конец периода (без отрицательных сальдо), руб.])		as [Прогноз.Сумма]
		FROM
			[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
			(qvd)
		Where 
			[Строка Тип]='КЗ'		and
			Дата='$(vДатаОстаток)' 	and
			Exists(ДО_Список, [ДО Наименование])	 //только ДО для ВОК
		Group By 
			 [ДО Наименование],  
		     Дата,
		     [Строка Тип];
	     
		
		//*************************************************ОРЕХ РАСХОД
		Concatenate (Остаток_КЗ)
		LOAD 
		     Year(Дата) as Год,
		     'КЗ' 							as [Прогноз.Признак],
		     'OPEX расход окт-дек'			as [Прогноз.Сценарий], 
		     account_ALIAS2					as Детали,
		     entity_ALIAS2 					as [ДО Наименование], 
		     date(DayStart(MonthEnd(Дата))) as Дата, 
		     fabs(sum(Данные*1000)*1.2)		as [Прогноз.Сумма]
		FROM
			[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
			(qvd)
		Where 
			Exists(ДО_Список, entity_ALIAS2)	 					and //только ДО
			KA_VGO_FLAG='KA' 										and //только сторонние
			counterparty<>'CT_TOTAL' 								and
			counterparty<>'CT_TOTAL_ALT' 							and
			scenario='SCN_FORECAST_09' 								and
			date(DayStart(MonthEnd(Дата)))>'$(vДатаОстаток)' 	 	and  
			date(DayStart(MonthEnd(Дата)))<'$(vДата_НачалоГода)' 	and
			//отбор для OPEX расход
			(account_ALIAS2='Прочие платежи (3и лица)' or  account_ALIAS2='Энерго и теплообеспечение производства (3и лица)')		 	
		Group By
			 Год, 
		     scenario, 
		     entity_ALIAS2, 
		     Дата,
		     account_ALIAS2;     
	     
	
		//*************************************************CAPEX РАСХОД			
		Concatenate (Остаток_КЗ)
		LOAD 
			Year(Дата) 						as Год,
			'КЗ' 							as [Прогноз.Признак],
			'CAPEX расход окт-дек' 			as [Прогноз.Сценарий],
		     entity_ALIAS2 					as [ДО Наименование], 
		     date(DayStart(MonthEnd(Дата))) as Дата, 
		     fabs(sum(Данные*1000*1.2))		as [Прогноз.Сумма],
		     account_ALIAS					as Детали
		FROM
			[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
			(qvd)	
		Where
			Exists(ДО_Список, entity_ALIAS2) 						and
			KA_VGO_FLAG='KA' 										and //только сторонние
			counterparty<>'CT_TOTAL' 								and
			counterparty<>'CT_TOTAL_ALT'							and
			scenario='SCN_FORECAST_09'  							and
			date(DayStart(MonthEnd(Дата)))>'$(vДатаОстаток)' 	 	and  
			date(DayStart(MonthEnd(Дата)))<'$(vДата_НачалоГода)' 	and
			Exists([Строка PL], account_ALIAS)		//только по строчкам "вне алгоритма"
		Group By
			scenario,
			entity_ALIAS2,
			Дата,
			account_ALIAS;
		
		DROP Table Вне_алгоритма;
		
		//*************************************************ОРЕХ ПЛАТЕЖИ
		Concatenate (Остаток_КЗ)
		LOAD 
		     Year(Период) 						as Год,
		     ДО 								as [ДО Наименование], 
		     'КЗ' 								as [Прогноз.Признак],
			 'OPEX платежи окт-дек' 			as [Прогноз.Сценарий],
		     date(DayStart(MonthEnd(Период))) 	as Дата, 
		     sum([Сумма план-факт]*1000000) 	as [Прогноз.Сумма], //в сиходнике суммы в миллионах
		     Группа2							as Детали
		FROM
			[$(vDataTier3)\Контроль БДДС\Дашборд Контроль БДДС\Данные.qvd]
			(qvd)
		Where 
			Exists(ДО_Список, ДО)									and //только ДО
			ДО<>'БРД' 												and
			[Отчетный период]='9+3' 								and
			date(DayStart(MonthEnd(Период)))>'$(vДатаОстаток)' 		and  
			date(DayStart(MonthEnd(Период)))<'$(vДата_НачалоГода)'	and
			WildMatch(Группа2, 	'Прочие платежи (3и лица)',
								'Энерго и теплообеспечение производства (3и лица)'
								)
		Group By
			 ДО, 
		     [Отчетный период],  
		     Год, 
		     Период,
		     Группа2;
		
		
		//*************************************************CAPEX ПЛАТЕЖИ	
		Concatenate (Остаток_КЗ)
		LOAD 
		     Year(Период) 						as Год,
		     ДО 								as [ДО Наименование], 
		     'КЗ' 								as [Прогноз.Признак],
			'CAPEX платежи окт-дек' 			as [Прогноз.Сценарий],
		     date(DayStart(MonthEnd(Период))) 	as Дата, 
		     sum([Сумма план-факт]*1000000) 	as [Прогноз.Сумма], //в сиходнике суммы в миллионах
		     Группа2							as Детали
		FROM
			[$(vDataTier3)\Контроль БДДС\Дашборд Контроль БДДС\Данные.qvd]
			(qvd)
		Where 
			Exists(ДО_Список, ДО) 									and //только ДО
			ДО<>'БРД' 												and
			[Отчетный период]='9+3' 								and
			date(DayStart(MonthEnd(Период)))>'$(vДатаОстаток)' 		and  
			date(DayStart(MonthEnd(Период)))<'$(vДата_НачалоГода)'	and
			Группа2='Платежи по Инвестиционной Программе с учетом отсрочек по факторингу (3и лица)'						
		Group By
			 ДО, 
		     [Отчетный период],  
		     Год, 
		     Период,
		     Группа2;	
		
		
		//*************************************************МТР
		Concatenate (Остаток_КЗ)
		LOAD 
		     Year(Период) 								as Год,
		     'КЗ' 										as [Прогноз.Признак],
		     [ДО Наименование], 
		     date(DayStart(MonthEnd(Период))) 			as Дата, 
		     if([Признак Данные]='Норматив Расход', 
		     	sum(Сумма*1.2)*(-1), 
		     	sum(Сумма*1.2))							as [Прогноз.Сумма],
		     [Признак Данные]&' окт-дек' 				as [Прогноз.Сценарий]
		FROM
			[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\МТР\МТР_Данные.qvd]
			(qvd)
		Where 
			([Признак Данные]='Норматив Приход' or [Признак Данные]='Норматив Расход') 	and //норматив расход = вовлечение, норматив приход - закупка
			date(DayStart(MonthEnd(Период)))>'$(vДатаОстаток)' 							and  
			date(DayStart(MonthEnd(Период)))<'$(vДата_НачалоГода)'						and
			[Фильтр в Карте МТР 1 уровень]='CAPEX'
		Group By
			[ДО Наименование],
			Период,
			[Признак Данные];
		
		
		//**************************************************** СОХРАНЕНИЕ ИТОГА КАК НАЧАЛО СЛЕДУЮЩЕГО ГОДА
		NoConcatenate
		ИТОГ:
		LOAD
			[Прогноз.Признак],
			[ДО Наименование],  
			MakeDate((Год+1), 1, 1) as Дата,
			sum([Прогноз.Сумма]) 	as [Прогноз.Сумма]
		Resident 
			Остаток_КЗ 
		Where 
			Год='$(vГОД)'
		Group By 
			[Прогноз.Признак],
			[ДО Наименование],
			Год;
		
		IF not WildMatch(Upper(ComputerName()),'SPB99-BRD-QV0*T*','SPB99-BRD-QV0*D*') THEN
			STORE ИТОГ into $(vXLSData_UFK)\_УФК БРД_общие данные\Приложения Qlik\Управление ВОК\ВОК\Остатки на начало года\ОстатокКЗ_прогноз_01_$(vГОД_НачалоГода).qvd;
		ENDIF
		
		STORE ИТОГ into $(vDataTier3)\Дашборд ВОК\Прогноз\Остатки на начало\ОстатокКЗ_прогноз_01_$(vГОД_НачалоГода).qvd;
		DROP Table Остаток_КЗ;
		DROP Table ИТОГ;		
			
	ENDIF

ENDSUB
///$tab Прогноз_Итог
SUB Прогноз_Итог
	
	//на начало года (уже рассчитано и не меняется)
	[Прогноз Данные]:
	LOAD 
		 '0+12' 							as [Прогноз.Сценарий],
	     [ДО Наименование], 
	     date(DayStart(MonthEnd((Дата+1)))) as Дата, 
	     Year(Дата+1) 						as Год,
	     if([ДО Наименование]='Ямал' and  (Year(Дата+1)=2023),
	       	sum(Round(Прогноз.Сумма))-78008455163,
	     	sum(Round(Прогноз.Сумма))) 		as Прогноз.Сумма,
	     0 									as [Признак наличия факта]
	FROM
		[$(vDataTier3)\Дашборд ВОК\Прогноз\Остатки на начало\ОстатокКЗ_прогноз_01_202*.qvd]
		(qvd)
	Group By 	
		[ДО Наименование],
		Дата;

ENDSUB
///$tab КЗ факт
SUB КЗ_факт
	
	Concatenate ([Прогноз Данные])
	LOAD * Where [Прогноз.Сценарий]<>'12+0';
	LOAD 
		 text((Num(Month(Дата))&'+'&Num(12-Month(Дата)))) 				as [Прогноз.Сценарий],
	     [ДО Наименование],  
	     Year(AddMonths(Дата,+1)) 										as Год,
	     date(DayStart(MonthEnd(AddMonths(Дата,+1)))) 					as Дата,  
	     sum([КЗ на конец периода (без отрицательных сальдо), руб.]) 	as [Прогноз.Сумма],
	     0 																as [Признак наличия факта]
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
		(qvd)
	Where 
		[Строка Тип]='КЗ' 			and
		Дата>=date('31.01.2022') 	and 
		Exists(ДО_Список, [ДО Наименование])	 //только ДО
	Group By 
		 [ДО Наименование],  
	     Дата;

ENDSUB
///$tab МТР
SUB МТР

	ТаблицаСоответствияСценариев:
	LOAD
		Год,
		[Сценарий Эталон] as [Прогноз.Сценарий]
	FROM 
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\ТаблицаСоответствияСценариев.qvd] (qvd);
	
	Inner Join (ТаблицаСоответствияСценариев)
	LOAD 
		 Year(Период) 													as Год,
	     [ДО Наименование], 
	     date(DayStart(MonthEnd(Период))) 								as Дата, 
	     sum(Сумма*if([Признак Данные]='Норматив Расход', -1.2, 1.2)) 	as [Прогноз.Сумма.CAPEX.МТР]
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\МТР\МТР_Данные.qvd]
		(qvd)
	Where 
		([Признак Данные]='Норматив Приход' or [Признак Данные]='Норматив Расход') and //норматив расход = вовлечение, норматив приход - закупка
		Year(Период)>=2022	 and
		[Фильтр в Карте МТР 1 уровень]='CAPEX'
	Group By
		[ДО Наименование],
		Период;
	
	Outer Join ([Прогноз Данные])
	LOAD 
		* ,
		if(ApplyMap('ПорядокОтчетности_Сортировка', [Прогноз.Сценарий])>=Month(Дата), 1,0) as [Признак наличия факта]
	Resident 
		ТаблицаСоответствияСценариев;
	DROP Table ТаблицаСоответствияСценариев;
	
ENDSUB
///$tab OPEX расход
SUB OPEX_расход

	ТаблицаСоответствияСценариев:
	LOAD
		Год,
		[Сценарий факт исходный СПО],
		[Сценарий Эталон] as [Прогноз.Сценарий]
	FROM 
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\ТаблицаСоответствияСценариев.qvd] (qvd);
	
	Inner Join (ТаблицаСоответствияСценариев)
	LOAD 
		 Год,
	     scenario 						as [Сценарий факт исходный СПО], 
	     entity_ALIAS2 					as [ДО Наименование], 
	     date(DayStart(MonthEnd(Дата))) as Дата, 
	     fabs(sum(Данные*1000)*1.2) 	as [Прогноз.Сумма.OPEX.расход]
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
		(qvd)
	Where 
		Exists(ДО_Список, entity_ALIAS2)	 									and //только ДО
		KA_VGO_FLAG='KA' 														and //только сторонние
		counterparty<>'CT_TOTAL' 												and
		counterparty<>'CT_TOTAL_ALT' 											and
		(account_ALIAS2='Прочие платежи (3и лица)' or 
		account_ALIAS2='Энерго и теплообеспечение производства (3и лица)')	 	and
		Год>=2022	
	Group By
		Год, 
	    scenario, 
	    entity_ALIAS2, 
	    Дата;
	DROP Field [Сценарий факт исходный СПО];
	
	Outer Join ([Прогноз Данные])
	LOAD 
		* ,
		if(ApplyMap('ПорядокОтчетности_Сортировка', [Прогноз.Сценарий])>=Month(Дата), 1,0) as [Признак наличия факта]
	Resident 
		ТаблицаСоответствияСценариев;
	DROP Table ТаблицаСоответствияСценариев;	
	
ENDSUB
///$tab OPEX платежи
SUB OPEX_платежи

	Outer Join ([Прогноз Данные])
	LOAD 
		 Год,
	     ДО 									as [ДО Наименование], 
	     [Отчетный период] 						as [Прогноз.Сценарий],  
	     date(DayStart(MonthEnd(Период))) 		as Дата, 
	     fabs(sum([Сумма план-факт]*1000000)) 	as [Прогноз.Сумма.OPEX.Платежи] //в сиходнике суммы в миллионах
	FROM
		[$(vDataTier3)\Контроль БДДС\Дашборд Контроль БДДС\Данные.qvd]
		(qvd)
	Where 
		Exists(ДО_Список, ДО)									and //только ДО
		ДО<>'БРД' 												and
		Год>=2022												and
		WildMatch(Группа2, 	'Прочие платежи (3и лица)',
							'Энерго и теплообеспечение производства (3и лица)'
							)
		and [Отчетный период]<>'0+12 акт'
	Group By
		 ДО, 
	     [Отчетный период],  
	     Год, 
	     Период;

ENDSUB
///$tab CAPEX расход
SUB CAPEX_расход
	
	Вне_алгоритма:
	LOAD Distinct 
		 [Строка PL]
	FROM
		[$(vDataTier1)\Excel\Контроль БДДС\Справочники\ALGORITM_DEPOS_SPO.qvd]
		(qvd)
	where 
		[Сдвиг данных] = 'вне алгоритма';
		
	ТаблицаСоответствияСценариев:
	LOAD
		Год,
		[Сценарий факт исходный СПО],
		[Сценарий Эталон] as [Прогноз.Сценарий]
	FROM 
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\ТаблицаСоответствияСценариев.qvd] (qvd);
	
	Inner Join (ТаблицаСоответствияСценариев)
	LOAD 
		 Год,
	     scenario 						as [Сценарий факт исходный СПО], 
	     entity_ALIAS2 					as [ДО Наименование], 
	     date(DayStart(MonthEnd(Дата))) as Дата, 
	     fabs(sum(Данные*1000*1.2)) 	as [Прогноз.Сумма.CAPEX.Расход]
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
		(qvd)	
	Where
		Exists(ДО_Список, entity_ALIAS2) 										and
		KA_VGO_FLAG='KA' 														and //только сторонние
		counterparty<>'CT_TOTAL' 												and
		counterparty<>'CT_TOTAL_ALT' and
		Год>=2022	 															and
		Exists([Строка PL], account_ALIAS)											//только по строчкам "вне алгоритма"
	Group By
		Год,
		scenario,
		entity_ALIAS2,
		Дата;
	
	DROP Table Вне_алгоритма;
	DROP Field [Сценарий факт исходный СПО];
	
	Outer Join ([Прогноз Данные])
	LOAD 
		* ,
		if(ApplyMap('ПорядокОтчетности_Сортировка', [Прогноз.Сценарий])>=Month(Дата), 1,0) as [Признак наличия факта]
	Resident ТаблицаСоответствияСценариев;
	DROP Table ТаблицаСоответствияСценариев;

ENDSUB
///$tab CAPEX платежи
SUB CAPEX_платежи
	
	Outer Join ([Прогноз Данные])
	LOAD 
		 Год,
	     ДО 									as [ДО Наименование], 
	     [Отчетный период] 						as [Прогноз.Сценарий],  
	     date(DayStart(MonthEnd(Период))) 		as Дата, 
	     fabs(sum([Сумма план-факт]*1000000)) 	as [Прогноз.Сумма.CAPEX.Платежи] //в исходнике суммы в миллионах
	FROM
		[$(vDataTier3)\Контроль БДДС\Дашборд Контроль БДДС\Данные.qvd]
		(qvd)
	Where 
		Exists(ДО_Список, ДО) 							and //только ДО
		ДО<>'БРД' 										and
		Год>=2022										and
		Группа2='Платежи по Инвестиционной Программе с учетом отсрочек по факторингу (3и лица)'			
		and [Отчетный период]<>'0+12 акт'			
	Group By
		 ДО, 
	     [Отчетный период],  
	     Год, 
	     Период;

ENDSUB
///$tab Генерация прогноза
/*
(sum({<Прогноз.Признак={'КЗ'}>} Прогноз.Сумма)
+sum({<Прогноз.Признак={'OPEX расход'}>} Прогноз.Сумма)
-sum({<Прогноз.Признак={'OPEX платежи'}>} Прогноз.Сумма)
+sum({<Прогноз.Признак={'CAPEX расход'}>} Прогноз.Сумма)
-sum({<Прогноз.Признак={'CAPEX МТР'}, Прогноз.Сценарий={'Норматив Расход'}>} Прогноз.Сумма)
+sum({<Прогноз.Признак={'CAPEX МТР'}, Прогноз.Сценарий={'Норматив Приход'}>} Прогноз.Сумма)
-sum({<Прогноз.Признак={'CAPEX платежи'}>} Прогноз.Сумма))/1000000
*/

sub Прогноз

	NoConcatenate
	t1:
	LOAD
	*,

	if([ДО Наименование]=Previous([ДО Наименование]) and [Прогноз.Сценарий]=Previous([Прогноз.Сценарий]) and Год=Previous(Год),
			Rangesum(peek('Прогноз_'), [Прогноз.Сумма.OPEX.расход], -[Прогноз.Сумма.OPEX.Платежи], [Прогноз.Сумма.CAPEX.Расход], -[Прогноз.Сумма.CAPEX.Платежи], [Прогноз.Сумма.CAPEX.МТР]),
			Rangesum(0,	   			   [Прогноз.Сумма.OPEX.расход], -[Прогноз.Сумма.OPEX.Платежи], [Прогноз.Сумма.CAPEX.Расход], -[Прогноз.Сумма.CAPEX.Платежи], [Прогноз.Сумма.CAPEX.МТР], [Прогноз.Сумма])) as Прогноз_,
			
	if([ДО Наименование]=Previous([ДО Наименование]) and [Прогноз.Сценарий]=Previous([Прогноз.Сценарий]) and Год=Previous(Год),
			Rangesum(peek('Прогноз'), [Прогноз.Сумма.OPEX.расход], -[Прогноз.Сумма.OPEX.Платежи], [Прогноз.Сумма.CAPEX.Расход], -[Прогноз.Сумма.CAPEX.Платежи], [Прогноз.Сумма.CAPEX.МТР]),
			Rangesum(0,	   			  [Прогноз.Сумма.OPEX.расход], -[Прогноз.Сумма.OPEX.Платежи], [Прогноз.Сумма.CAPEX.Расход], -[Прогноз.Сумма.CAPEX.Платежи], [Прогноз.Сумма.CAPEX.МТР], [Прогноз.Сумма])) as Прогноз;
	LOAD
		[Прогноз.Сценарий],
		[ДО Наименование],  
		Год,
		Дата,  
		[Прогноз.Сумма],
		[Признак наличия факта],
		[Прогноз.Сумма.OPEX.расход],
		[Прогноз.Сумма.OPEX.Платежи],
		[Прогноз.Сумма.CAPEX.Расход],
		[Прогноз.Сумма.CAPEX.Платежи],
		[Прогноз.Сумма.CAPEX.МТР]
	Resident 
		[Прогноз Данные]
	Where 
		[Признак наличия факта]=0
	Order By
		[ДО Наименование], 
		Год,
		[Прогноз.Сценарий],
		Дата asc;

	DROP Table [Прогноз Данные];
	
	
	//*********************************************************************для уровня блока
	NoConcatenate
	t2_ДанныеБлок:
	LOAD 
		Дата, 
		Год,
		[Прогноз.Сценарий] ,
		sum([Прогноз.Долгосрочный факторинг Блок]) as [Прогноз.Долгосрочный факторинг Блок]
	Where [Признак наличия факта]=0
	Group By Дата, Год,[Прогноз.Сценарий];
	LOAD 
	     date(DayStart(MonthEnd(Период))) as Дата, 
	     Год, 
	     [Отчетный период] as [Прогноз.Сценарий], 
	     sum(Лимит*1000000) as [Прогноз.Долгосрочный факторинг Блок],  //изначально суммы в миллионах
	     if(ApplyMap('ПорядокОтчетности_Сортировка', [Отчетный период])>=Month(Период), 1,0) as [Признак наличия факта]
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\Атлас\Лимиты_Финансирование_Освоение.qvd]
		(qvd)
	Where
		Категория='Сверхнормативная рассрочка платежей'
		and ЮЛ='ПАО Газпром нефть'
		and CONS_PRINCIPLE='Финансирование'
		and Год>=2023
		and [Отчетный период]<>'0+12 акт'
	Group By
		 Период, 
	     Год, 
	     [Отчетный период];	
	
	Итог:
	LOAD
		Дата,
		Год,
		[Прогноз.Сценарий],
		[Прогноз.Долгосрочный факторинг Блок]*(-1.2) as Прогноз_Блок
	Resident 
		t2_ДанныеБлок;
	
	DROP Table t2_ДанныеБлок;
	
	Concatenate (Итог)
	LOAD * Resident t1;
	DROP Table t1;

	NoConcatenate
	Прогноз:
	LOAD 
		[Прогноз.Сценарий],
		[ДО Наименование],  
		Год,
		Дата,  
		Прогноз as [Прогноз без факторинга],
		Прогноз_ as Прогноз,
		Прогноз_Блок as [Прогноз.Долгосрочный факторинг Блок] //сумма факторинга по Блоку
	Resident Итог;

	STORE Прогноз into $(vDataTier3)\Дашборд ВОК\Прогноз\Прогноз_КЗ.qvd;
	DROP Table Прогноз;		
	
ENDSUB
///$tab Факторинг_Прогноз
/*
Прогноз факторинга – меняем логику – чтобы посчитать на конец месяца прогнозного факторинг, мы берем факт предыдущего месяца и вычитаем значения за каждый месяц накопительным итогом 
(в Атласе берем срез финансирование и только *факторинг*)
*/

SUB Факторинг_Прогноз
	
	//загрузка факта - остатки на конец месяца из АРМ КК		
	КЗ_Факторинг:
	LOAD 
		 [ДО Наименование], 
		 [Тип платежа],
		 'Факт'  																			as [Факторинг.Тип платежа],   
	     date(if(Month(Дата)=12, date(Floor(MonthEnd(MakeDate(Year(Дата)+1, 1)))), Дата))	as [Факторинг.Дата], 
	     if(Month(Дата)=12,'0+12', Num(Month(Дата))&'+'&(12-Num(Month(Дата)))) 				as [Отчетный период],
		 if(Month(Дата)=12,Год+1, Год)  													as [Факторинг.Год], 
	     sum([КЗ на конец периода (без отрицательных сальдо), руб.])						as [факторинг.КЗ на конец периода руб.]
	FROM
		[$(vDataTier3)\Дашборд ВОК\Лист_0 Общий\КЗ_Факторинг.qvd]
		(qvd)
	Where 
		Дата>date('01.12.2023') 
		and WildMatch([Тип платежа], 'краткосрочный факторинг', 'долгосрочный факторинг', 'комиссия за факторинг')
		and Exists(ДО_Список, [ДО Наименование])
	Group  By
		[ДО Наименование],
		Дата,
		Год,
		[Тип платежа];
	
	//добавляю прогноз из Атласа (ДДС)
	Concatenate (КЗ_Факторинг)
	LOAD
		[Факторинг.Дата], 
		[Факторинг.Год], 
		[Отчетный период],
		[forecast_name Исходное поле Атлас],
		[ДО Наименование], 
		[Факторинг.Тип платежа],
		[Тип платежа],
		
		//зануляю движения за фактические месяцы в сценариях, так как по ним подставлю остаток факт на дату
		if(Month([Факторинг.Дата])<ApplyMap('ПорядокОтчетности_Сортировка',[Отчетный период], 0)+1, 
	     	0,  
	     	if([Тип платежа]='комиссия за факторинг', 
	     		Сумма*1000000, 
	     		Сумма*-1000000)) 		as [факторинг.КЗ на конец периода руб.];	
	LOAD 
		 date(daystart(Период))			as [Факторинг.Дата],  
	     Год 							as [Факторинг.Год],  
	     [Отчетный период],
	     [forecast_name Исходное поле Атлас],
	     sum(Сумма)						as Сумма,
	     ДО								as [ДО Наименование],
	     'Прогноз'  					as [Факторинг.Тип платежа],
	     if(WildMatch(Категория, 'Проценты за факторинг*'), 			 'комиссия за факторинг',
	     if(WildMatch(Категория, 'Факторинг 3 года', 'Факторинг 7 лет'), 'долгосрочный факторинг', 'краткосрочный факторинг')) as [Тип платежа]
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\Атлас\Факторинг_Прогноз.qvd]
		(qvd)
	Where 
		Год>=2023
		and Exists(ДО_Список, ДО)
	Group By
		if(WildMatch(Категория, 'Проценты за факторинг*'), 				'комиссия за факторинг',
	    if(WildMatch(Категория, 'Факторинг 3 года', 'Факторинг 7 лет'), 'долгосрочный факторинг', 'краткосрочный факторинг')),
		[Отчетный период], 
		[forecast_name Исходное поле Атлас],
		Категория,
		Период,
		Год, 
	    ДО;
	
	//добавляю накопительный календарь, так как движения по прогнозу прибавляем накоплительно
	Left Join (КЗ_Факторинг)
	[Календарь оборачиваемость]:
	LOAD Distinct
		[Дата для оборачиваемости],
		Период as [Факторинг.Дата],
		if([Дата для оборачиваемости]=Период, 1,0) as Признак
	FROM 
		[$(vDataTier3)\Дашборд ВОК\Лист_1 ВОК\Календарь оборачиваемость.qvd] (qvd)
	Where  
		[Признак с начала года]=1;
	
	STORE КЗ_Факторинг into $(vDataTier3)\Дашборд ВОК\Прогноз\Прогноз_КЗ_Факторинг.qvd;
	DROP Table ДО_Список;
//	DROP Table КЗ_Факторинг;

ENDSUB
///$tab CALLs
CALL ServiceTBLs
CALL MapTBLs
CALL ОстатокНаНачалоГода_0_12

CALL Прогноз_Итог
CALL КЗ_факт
CALL МТР
CALL OPEX_расход
CALL OPEX_платежи
CALL CAPEX_расход
CALL CAPEX_платежи
CALL Прогноз
CALL Факторинг_Прогноз