///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);
///$tab ServiceTBLs
SUB ServiceTBLs

	ДО_Список:
	LOAD  Distinct
		[БЕ Код],
		[ДО Кратко]   as ДО_Список  
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.ВОК]=1; //только для вкладки ВОК	

ENDSUB
///$tab MapTBLs
SUB MapTBLs

	ПорядокОтчетности_Сортировка:
	Mapping
	LOAD * INLINE [
	Значение, 	Порядок
	0+12,		0
	1+11,		1	
	2+10,		2
	3+9, 		3
	4+8,		4
	5+7,		5
	6+6,		6
	7+5,		7
	8+4,		8
	9+3,		9
	10+2,		10
	11+1,		11
	12+0,		12
	];

ENDSUB
///$tab МТР
SUB МТР

	ТаблицаСоответствияСценариев:
	LOAD
		Год,
		[Сценарий Эталон] as [Прогноз.Сценарий]
	FROM 
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\ТаблицаСоответствияСценариев.qvd] (qvd);
	
	Inner Join (ТаблицаСоответствияСценариев)
	LOAD 
		 Year(Период) as Год,
	     [ДО Наименование], 
	     date(DayStart(MonthEnd(Период))) 	as Дата, 
	     sum(Сумма) 				as [Прогноз.Сумма.МТР]
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\МТР\МТР_Данные.qvd]
		(qvd)
	Where 
		if(Year(Период)<=2023, 
			if(WildMatch([ДО Наименование], 'Шельф', 'Мегион'),
				[Признак Данные]='Запас',  
				[Признак Данные]='Норматив Запас МТР на конец'),
		if(Year(Период)>=2024,
			[Признак Данные]='Запас'))
	Group By
		[ДО Наименование],
		Период;
	
	NoConcatenate
	t1:
	LOAD * Where [Признак наличия факта]=0;
	LOAD 
		* ,
		if(ApplyMap('ПорядокОтчетности_Сортировка', [Прогноз.Сценарий])>=Month(Дата), 1,0) as [Признак наличия факта]
	Resident 
		ТаблицаСоответствияСценариев;
	DROP Table ТаблицаСоответствияСценариев;
	DROP Table ДО_Список;
	
	STORE t1 into $(vDataTier3)\Дашборд ВОК\Прогноз\Прогноз_МТР.qvd;
	
ENDSUB
///$tab CALLs
CALL ServiceTBLs
CALL MapTBLs
CALL МТР
