///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);


///$tab MapTBLs
SUB MapTBLs

       Месяц_Период:
	Mapping
	LOAD * INLINE [
	    Поле1, 		Поле2
		январь, 	1 
		февраль, 	2
		март, 		3
		апрель, 	4
		май, 		5
		июнь, 		6
		июль, 		7
		август, 	8
		сентябрь, 	9
		октябрь, 	10
		ноябрь, 	11
		декабрь,	12
		Янв, 	1 
		Фев, 	2
		Мар, 		3
		Апр, 	4
		Май, 		5
		Июн, 		6
		Июл, 		7
		Авг, 	8
		Сен, 	9
		Окт, 	10
		Ноя, 	11
		Дек,	12
	];

ENDSUB

///$tab Список ДО_СП
SUB Список_ДО_СП

	//Результирующий список ДО. Приразломное за все периоды приравниваю к Шельфу
	//Результирующий список ДО. Приразломное за все периоды приравниваю к Шельфу
	ДО_ВОК:
	LOAD distinct
		[корр типа],
		[Номер в SAP],
		[БЕ Код],
		[МСФО (MVD0O0O)],
		[ТИП ДО],
		[ДО/СП],
		[Признак ДО.ВОК],
		[Признак ДО.Резервы],
		[Признак ДО.БДДС],
		[Признак ДО.МТР],
		[Признак ДО.НЗС],
		[ДО АРМ КК],
		[ВОК (вкладка КПД)],
		[ДО Атлас],
		[ДО Атлас (2)],
		[ДО Атлас (3)],
		if([Краткое наименование ДО]='Приразломное', 'Шельф',  	  [Краткое наименование ДО]) as [ДО Кратко],
		if([Наименование ДО]='ГПН-Приразломное', 	 'ГПН-Шельф',  [Наименование ДО]) 		 as Наименование;
	LOAD distinct
		[БЕ
*(для ДО на SAP)] as [БЕ Код],
		[Код МСФО 
*поле MVD0O0O] 	as [МСФО (MVD0O0O)],
	 	 [Наименование ДО], 
	     [Краткое наименование ДО], 
	 	 [Тип ДО] as [ТИП ДО],
		 [ДО/СП],
		 [ВОК
*(все вкладки)] as [Признак ДО.ВОК],
		 [ВОК 
*вкладка Резервы] as [Признак ДО.Резервы],
		 [ВОК 
*вкладка БДДС] as [Признак ДО.БДДС],
		 МТР as [Признак ДО.МТР],
		 НЗС as [Признак ДО.НЗС],
		 [ДО АРМ КК],
		 [ВОК (вкладка КПД)],
		 [ДО Атлас],
		 [ДО Атлас (2)],
		 [ДО Атлас (3)],
		 [корр типа],
		 [Номер в SAP]		
	FROM
		[$(vXLSData_UFK)\_УФК БРД_общие данные\НСИ УФК БРД.xlsx]
		(ooxml, embedded labels, table is [Список ДО_СП])
	Where
		Блок='БРД';
	
	STORE ДО_ВОК INTO [$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd] (qvd);
	DROP TABLE ДО_ВОК;
	
ENDSUB
///$tab ДО_ОЕ_ка
SUB ДО_ОЕ_ка

	НомерКА_ВГО:
	LOAD Distinct
		Repeat('0', 10-Len(([Номер контрагента
(для SAP)])))&([Номер контрагента
(для SAP)]) as НомерКА,
	     [Наименование ДО],
		 date([Дата перехода в СП]) as [Дата перехода в СП]
	FROM
	     [$(vXLSData_UFK)\_УФК БРД_общие данные\НСИ УФК БРД.xlsx]
	     (ooxml, embedded labels, table is [ДО_ОЕ_ка]);
	
	STORE НомерКА_ВГО INTO [$(vDataTier1)\Excel\Дашборд ВОК\Контрагенты ВГО.qvd] (qvd);
	DROP TABLE НомерКА_ВГО;
	
ENDSUB
///$tab Виды ОА
SUB Виды_ОА

	[Оценочные резервы Список]:
	LOAD 
		[Наименование счета]			as [As is],
	     [Вид оценочного обязательства] as [To be]
	FROM
		[$(vXLSData_UFK)\_УФК БРД_общие данные\НСИ УФК БРД.xlsx]
		(ooxml, embedded labels, table is [Виды ОА]);
	
	STORE [Оценочные резервы Список] INTO [$(vDataTier1)\Excel\Дашборд ВОК\Оценочные резервы Список.qvd] (qvd);
	DROP TABLE [Оценочные резервы Список];
	
ENDSUB

///$tab КПЭ_ДД
SUB КПЭ_ДД

	Данные:
	CrossTable(Месяц, Данные, 2)
	LOAD [Код в БЕ], 
	     Год, 
	     Янв, 
	     Фев, 
	     Мар, 
	     Апр, 
	     Май, 
	     Июн, 
	     Июл, 
	     Авг, 
	     Сен, 
	     Окт, 
	     Ноя, 
	     Дек
	FROM
		[$(vXLSData_UFK)\_УФК БРД_общие данные\НСИ УФК БРД.xlsx]
		(ooxml, embedded labels, table is [КПЭ ДД]);
	
	КПЭ_ДД:
	//данные в млн руб.
	LOAD
		Round(Данные, 0.001) as Данные,
		MakeDate(Год, ApplyMap('Месяц_Период', Месяц),) as Период,
		[Код в БЕ]
	Resident Данные;
	DROP Table Данные;
	
	STORE КПЭ_ДД into $(vDataTier1)\Excel\Дашборд ВОК\КПЭ_ДД.qvd;
	DROP table КПЭ_ДД;

ENDSUB
		
///$tab КП УРО
SUB КПЭ_УРО	
	
	Данные:
	CrossTable(Месяц, Данные, 2)
	LOAD [Код в БЕ], 
	     Год, 
	     Янв, 
	     Фев, 
	     Мар, 
	     Апр, 
	     Май, 
	     Июн, 
	     Июл, 
	     Авг, 
	     Сен, 
	     Окт, 
	     Ноя, 
	     Дек
	FROM
		[$(vXLSData_UFK)\_УФК БРД_общие данные\НСИ УФК БРД.xlsx]
		(ooxml, embedded labels, table is [КПЭ УРО]);
	
	КПЭ_УРО:
	//данные в млн руб.
	LOAD	
		Round(Данные, 0.001) as Данные,
		[Код в БЕ],
		MakeDate(Год, ApplyMap('Месяц_Период', Месяц),) as Период
	Resident Данные;
	DROP Table Данные;
	
	STORE КПЭ_УРО into $(vDataTier1)\Excel\Дашборд ВОК\КПЭ_УРО.qvd;
	DROP table КПЭ_УРО;
	
ENDSUB
///$tab Счета_исключения
SUB счета_Исключения

     //для ДЗ, КЗ, Резервов
	Счета_Исключения_TMP:
	CrossTable(БЕ, Данные, 1)
	LOAD F1 as Счет, 
	     [1000], 
	     [2010], 
	     [5680], 
	     [5855], 
	     [8450], 
	     [1150], 
	     [6825], 
	     [5063], 
	     [1020], 
	     [1010], 
	     *
	FROM
	[$(vXLSData_UFK)\_УФК БРД_общие данные\НСИ УФК БРД.xlsx]
	(ooxml, embedded labels, header is 4 lines, table is [постановка счетов SAP]);

	STORE Счета_Исключения_TMP into $(vDataTier1)\Excel\Дашборд ВОК\Счета_Исключения_TMP.qvd;
	DROP table Счета_Исключения_TMP;

    //для МТР
    [Счета_МТР]:
	LOAD 
		[Счет из карты МТР], 
	     [ТИП МТР], 
	     [Счет ББ]
	FROM
          [$(vXLSData_UFK)\_УФК БРД_общие данные\НСИ УФК БРД.xlsx]
          (ooxml, embedded labels, table is [счета МТР]);
	
     STORE Счета_МТР into $(vDataTier1)\Excel\Дашборд ВОК\Счета_МТР.qvd;
	DROP table Счета_МТР;

ENDSUB

///$tab Периоды
SUB Периоды
	
	LET vStart_Date = MakeDate('$(vYear_Dashboard)', 1,1);  
	LET vEnd_Date   = date(daystart(YearEnd('$(vToday)')));
	
	Даты_TMP:
	LOAD
		date('$(vStart_Date)' +RowNo()-1) as  Дата
	AutoGenerate date('$(vEnd_Date)')-'$(vStart_Date)';
	
	NoConcatenate
	Даты:
	LOAD Distinct
		Year(Дата) 						as Год,
		date(DayStart(MonthEnd(Дата))) 	as Период
	Resident Даты_TMP;
			
	DROP Table Даты_TMP;
	STORE Даты INTO [$(vDataTier1)\Excel\Дашборд ВОК\Периоды.qvd];
	DROP Table Даты;
	
ENDSUB
///$tab Атлас_ВыгрузкаЕксель
SUB Атлас_ВыгрузкаЕксель

	SET vПуть = '$(vXLSData_UFK)\_УФК БРД_общие данные\Приложения Qlik\Управление ВОК\ДДС\Атлас\Авансы ексель';
	
	Данные:
	LOAD * Inline [
	Сценарий
	];
			
	FOR EACH vDir0 IN DirList ('$(vПуть)\*') 	
		LET vYear = Replace('$(vDir0)', '$(vПуть)\', '');	
		
		FOR EACH vDir1 IN DirList ('$(vПуть)\$(vYear)\*')	
			LET vОтчетныйПериод = Replace('$(vDir1)', '$(vПуть)\$(vYear)\', '');
			FOR EACH vFile IN FileList('$(vDir1)\*.xlsx')
			LET vFileName		= Replace('$(vFile)', '$(vDir1)\', '');		
					
			Concatenate (Данные)		
			LOAD 
				'$(vОтчетныйПериод)' 													as Сценарий,
				'$(vYear)' 													as Год,
				[Операционная единица (ОЕ)],
				[ЮЛ, финансирующее инвестиции]	 							as [Наименование ДО], 
				[ЮЛ, финансирующее инвестиции] 							as [ДО Наименование Исходное],
				if(WildMatch(Статья, 'САРЕХ',  'CAPEX'), 'САРЕХ',Статья)	as [САРЕХ/OPEX],		 
				'Не указано' 												as [Наименование КП (если применимо)],
				[Наименование подрядной организации] 						as [Наименование ПО],
				ИНН 														as ИНН,
				[Статус договора] 											as [Статус контрактования],
				[Номер договора] 											as [Номер договора],
				'Не указано' 												as [Срок полного погашения аванса], 
				'Не указано' 												as [Наличие БГ],
				'Не указано' 												as [Иное обеспечение],	
				Детализация 												as [Категория аванса],
				'Не указано' 												as [Тип аванса], 
				[Комментарии 2023] 											as Обоснование, 
			     [Янв $(vYear) фин],
			     [Фев $(vYear) фин], 
			     [Мар $(vYear) фин], 
			     [Апр $(vYear) фин], 
			     [Май $(vYear) фин], 
			     [Июн $(vYear) фин], 
			     [Июл $(vYear) фин], 
			     [Авг $(vYear) фин], 
			     [Сен $(vYear) фин], 
			     [Окт $(vYear) фин], 
			     [Ноя $(vYear) фин], 
			     [Дек $(vYear) фин], 
			
			     [Янв $(vYear) осв], 
			     [Фев $(vYear) осв], 
			     [Мар $(vYear) осв], 
			     [Апр $(vYear) осв], 
			     [Май $(vYear) осв], 
			     [Июн $(vYear) осв], 
			     [Июл $(vYear) осв], 
			     [Авг $(vYear) осв], 
			     [Сен $(vYear) осв], 
			     [Окт $(vYear) осв], 
			     [Ноя $(vYear) осв], 
			     [Дек $(vYear) осв] 
			FROM
				[$(vFile)]
				(ooxml, embedded labels, table is [Данные от ДО (руб)]);
				
										
			NEXT vFile
		NEXT vDir1
	NEXT vDir0
	
	
	План_1:
	CrossTable(Период, Сумма, 17)
	LOAD * Resident Данные;	
	DROP Table Данные;

	План_2:
	NoConcatenate
	LOAD
		*,
		if(Признак='Финансирование', Сумма*1000000, 0) 	as [Сумма авансов, планируемых к выдаче в текущем году, руб.], 
		if(Признак='Освоение', 		 Сумма*1000000, 0) 	as [Размер погашения до конца года по текущему прогнозу, руб.], 
		date(DayStart(MonthEnd(Период))) 				as Дата
		;
	LOAD
		 Сценарий,
		 [Операционная единица (ОЕ)],
		 [Наименование ДО], 
		 [ДО Наименование Исходное],
		 [САРЕХ/OPEX],		 
	     [Наименование КП (если применимо)],
	     [Наименование ПО],
	     ИНН,
	     [Статус контрактования],
	     [Номер договора],
	     [Срок полного погашения аванса], 
	     [Наличие БГ],
	     [Иное обеспечение],
	     [Категория аванса],
	     [Тип аванса], 
	     Обоснование, 
	     if(Период like '*фин', 'Финансирование', 'Освоение') 		as Признак,
	     MakeDate(Right(Replace(Replace(Период, ' фин', ''), ' осв', ''),4), ApplyMap('Месяц_Период', Left(Replace(Replace(Период, ' фин', ''), ' осв', ''),3))) 		
	     															as Период,
	     Right(Replace(Replace(Период, ' фин', ''), ' осв', ''),4) 	as Год,
	     Сумма
	Resident План_1
	Where Сумма<>0;
	DROP Table План_1;
	
	DROP Field Период, Сумма;
	STORE План_2 into [$(vDataTier1)\Excel\Дашборд ВОК\Атлас_Выгрузка_Ексель.qvd];
	DROP Table План_2;
	
ENDSUB
///$tab Резервы_КПД
SUB Резервы_КПД

	ДО_map_Полный:
	Mapping
	LOAD Distinct     
	     [ДО АРМ КК],
	     [ДО Кратко]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd); 

	Резервы_Excel:
	LOAD 
	    // [ДО Наименование], 
		  ApplyMap('ДО_map_Полный',[ДО Наименование],[ДО Наименование])	as [ДО Наименование],
	     [Договор Номер], 
	     [Контрагент ИНН], 
	     Round([Резерв на конец периода (без отрицательных сальдо), руб.], 0.01) as [Резерв на конец периода (без отрицательных сальдо), руб.]
	FROM
		[$(vXLSData_UFK)\ПАО ГПН\КПД\Резервы 62 счет.xlsx]
		(ooxml, embedded labels, table is Резервы_62сч)
	Where [Резерв на конец периода (без отрицательных сальдо), руб.]<>0;
	
	STORE Резервы_Excel into [$(vDataTier1)\Excel\Дашборд ВОК\Резервы_Excel.qvd];
	DROP Table Резервы_Excel;

ENDSUB
///$tab CALLs
CALL MapTBLs
CALL Список_ДО_СП
CALL ДО_ОЕ_ка
CALL Виды_ОА
CALL КПЭ_ДД
CALL КПЭ_УРО
CALL счета_Исключения
CALL Периоды
CALL Атлас_ВыгрузкаЕксель
CALL Резервы_КПД