///$tab Description
/*********************************************************************
Extractor: 02-07_Transform SAP for UFKBRD АРМ КК.qvs
Version: 1.0
Author: Doshlova.YuV
Date created: 2021/09/01
Date last modified: 2021/09/01
Description: Приложение преобразовывает данные из приложения АРМ КК
Extractor for application: Дашборд ВОК.qvw 
----------------------------------------------------------------------
Version: 1.0
Author: 
Date last modified: 2021/09/01
Changes: 
 - Initial version
*********************************************************************/
///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);


///$tab MapTBLs
SUB MapTBLs
	
	Мэппинг_АРМКК:
	Mapping
	LOAD Distinct     
	     [ДО АРМ КК],
	     [ДО Кратко]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.Резервы]=1; //только для вкладки ВОК	
		
	ДО_map:
	Mapping
	LOAD Distinct     
	     [ДО АРМ КК],
	     [ДО Кратко]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.ВОК]=1; //только для вкладки ВОК	
	
	ДО_map_Полный:
	Mapping
	LOAD Distinct     
	     [ДО АРМ КК],
	     [ДО Кратко]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd); 
	
	Блок_map:
	Mapping
	LOAD Distinct     
	     [ДО АРМ КК],
	     [ВОК (вкладка КПД)]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		not IsNull([ВОК (вкладка КПД)]); //только для вкладки КПД

	MAP_Месяц_Период:
	Mapping
	LOAD * INLINE [
		Поле1, Поле2
		янв, 1
		фев, 2
		февр, 2
		мар, 3
		март, 3
		апр, 4
		май, 5
		июн, 6
		июнь, 6
		июл, 7
		июль, 7
		авг, 8
		сен, 9
		сент, 9
		окт, 10
		ноя, 11
		нояб, 11
		дек, 12
	];

ENDSUB
///$tab АРМ КК
SUB АРМ_КК

	АРМ_КК_Данные:
	LOAD 
		 [Бухгалтерский счет],
		 [Договор Номер],
		 [Контрагент ИНН],
		 [Код контрагента в АУС],
		 [Задолженность Тип], 
		 [Задолженность Вид], 
		 [Обеспечение признак наличия],
		 [Контрагент Наименование],
		 Комментарии,
		 [Контрагент Тип],
		 'АРМ КК' 														as [Источник данных],
		 ApplyMap('ДО_map', [ДО Наименование], Null()) 					as [ДО Наименование], 
		 ApplyMap('ДО_map_Полный',[ДО Наименование],[ДО Наименование])	as [ДО Наименование Исходное],
		 ApplyMap('Мэппинг_АРМКК', [ДО Наименование], Null()) 			as [ДО Наименование Резервы],
		 ApplyMap('Блок_map', [ДО Наименование], Null()) 				as [Подразделение Наименование КПД],  
	     Дата, 
	     [Строка Тип], 
	     [Блок Наименование], 
	     [Авансы Выплаченные (оборот Дт), руб.], 
	     [Авансы Сумма на начало периода (без отрицательных сальдо), руб.], 
		 [Авансы выплаченные (оборот Дт) (без отрицательных сальдо), руб.], 
     	 [Авансы погашенные (оборот Кт) (без отрицательных сальдо), руб.], 
		 [Авансы Сумма на конец периода (без отрицательных сальдо), руб.] as [Авансы Сумма на конец периода (без отрицательных сальдо), руб. Исходное], 
	     [Аванс за вычетом резервов (без отрицательных сальдо), руб.] as [Авансы Сумма на конец периода (без отрицательных сальдо), руб.], 
	     if([Задолженность Общая (за вычетом резервов) переоценка, руб.]>0, [Задолженность Общая (за вычетом резервов) переоценка, руб.], 0) as [Задолженность Общая (за вычетом резервов) переоценка, руб.],  
	     [Сумма без обеспечения, руб.], 
	     [Задолженность Текущая переоценка, руб.], 
		 [КЗ на начало периода (без отрицательных сальдо), руб.], 
    	 [КЗ на конец периода (без отрицательных сальдо), руб.], 
		 [КЗ погашение (оборот Дт) (без отрицательных сальдо), руб.],
		 [КЗ увеличение (оборот Кт) (без отрицательных сальдо), руб.],
		 [КЗ погашение (оборот Дт), руб.] ,
		 [КЗ увеличение (оборот Кт), руб.],
		 
		 [Резерв на конец периода, руб.],
		 [Резерв на начало периода (без отрицательных сальдо), руб.],
		 [Резерв на конец периода (без отрицательных сальдо), руб.],
		 [Резерв начисление (без отрицательных сальдо), руб.],
		 [Резерв восстановление за счет списания (без отрицательных сальдо), руб.],
		 [Резерв восстановление за счет погашения (без отрицательных сальдо), руб.],
		 
	     if([Задолженность Общая (за вычетом резервов) переоценка, руб.]>0, [Задолженность Просроченная переоценка, руб.], 0) as [Задолженность Просроченная переоценка, руб.], 
	     БЛОК, 
	     ДО,
		 if([Задолженность Общая (за вычетом резервов) переоценка, руб.]>0, [Задолженность просроченная (>30 дней) переоценка, руб.], 0) as [Задолженность просроченная (>30 дней) переоценка, руб.],
		 if([Задолженность Общая (за вычетом резервов) переоценка, руб.]>0, [Задолженность просроченная (>5 и <=30 дней) переоценка, руб.], 0) as [Задолженность просроченная (>5 и <=30 дней) переоценка, руб.],
		 [Дата погашения] 																	as [Дата погашения Исходное],
		if(len(LTrim(Num([Дата погашения])))=5, date([Дата погашения]),
		IF(	Left(Replace(Trim([Дата погашения]),chr(160),''),10) like '??.??.????', //chr(160) - неразрывный пробел (U+00A0), trim() его не видит
			Date(Left(Replace(Trim([Дата погашения]),chr(160),''),10)),
			MakeDate(
				'20'&SubField(trim([Дата погашения]),chr(39),2),
				ApplyMap('MAP_Месяц_Период',SubField(trim([Дата погашения]),chr(39),1),1)
			)
		))																					as [Дата погашения],
		if([Бухгалтерский счет]='7620639000', 'долгосрочный факторинг' ,
		if([Бухгалтерский счет]='7620638000', 'краткосрочный факторинг',
		if([Бухгалтерский счет]='7620302010', 'комиссия за факторинг', Null()))) 			as [Тип платежа]
	FROM
		[$(vRHD_Interlayer)\Hybrid_FINAL_Main_Data_With_Checks.qvd]
		(qvd)
	Where 
		Year(Дата)>='$(vYear_Dashboard)';
	
	STORE АРМ_КК_Данные into $(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd;	

ENDSUB

///$tab Резерв_АРМ_КК
SUB Резерв_АРМ_КК

	[Данные АРМ]:
	LOAD 
		[Контрагент Наименование], 
	    Дата,
	    [Блок Наименование], 
	    [ДО Наименование Резервы] as  [ДО Наименование], 	
	    [Задолженность Вид], 
	    [Задолженность Тип],
	    sum([Резерв на начало периода (без отрицательных сальдо), руб.]) 				as [Резерв на начало периода (без отрицательных сальдо), руб.],
	    sum([Резерв на конец периода (без отрицательных сальдо), руб.])					as [Резерв на конец периода (без отрицательных сальдо), руб.], 
	    sum([Резерв начисление (без отрицательных сальдо), руб.])						as [Резерв начисление (без отрицательных сальдо), руб.], 
	    sum([Резерв восстановление за счет списания (без отрицательных сальдо), руб.]) 	as [Резерв восстановление за счет списания (без отрицательных сальдо), руб.],
		sum([Резерв восстановление за счет погашения (без отрицательных сальдо), руб.])	as [Резерв восстановление за счет погашения (без отрицательных сальдо), руб.]
	Resident
		АРМ_КК_Данные
	where 
		not IsNull([ДО Наименование Резервы])  	and
		[Строка Тип] = 'Резервы' 				and
		WildMatch([Блок Наименование],	'БРД ДГиЭ ГПН',
										'БРД ДО/Дирекция ГРР',
										'БРД ДО/Дирекция по добыче',
										'БРД ДО/Дирекция по крупным проектам',
										'БРД ДО/Дирекция по технологиям',
										'БРД ДО/Иностранные проекты',
										'БРД ДО/Нефтесервисы',
										'БРД подр-я ГПН',
										'БРШП ДО') 
	Group By
		[Контрагент Наименование], 
	    Дата,  
	    [Блок Наименование],
		[ДО Наименование Резервы],
		[Задолженность Вид], 
	    [Задолженность Тип];
	
	DROP Table АРМ_КК_Данные;
	STORE [Данные АРМ] into $(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ БК\Резерв Данные Резерв ДЗ.qvd;
	DROP Table [Данные АРМ];

ENDSUB

///$tab CALLs
CALL MapTBLs
CALL АРМ_КК
CALL Резерв_АРМ_КК