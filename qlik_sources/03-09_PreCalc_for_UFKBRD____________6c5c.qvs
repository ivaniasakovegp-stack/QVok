///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);
///$tab ServiceTBLs
SUB ServiceTBLs

	ДО_Список:
	LOAD  Distinct
		[БЕ Код],
		[ДО Кратко]   as ДО_Список,
		[ДО Кратко]   as В_Периметре_ВОК  
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where 
		[Признак ДО.ВОК]=1; //только для вкладки ВОК	
	
ENDSUB
///$tab MapTBLs
SUB MapTBLs

	ПорядокОтчетности_Сортировка:
	Mapping
	LOAD 
		Значение,
		Порядок-1 as  Порядок
	FROM [$(vDataTier1)\Excel\Контроль БДДС\Справочники\Сценарии.qvd] (qvd);	

ENDSUB
///$tab ОстатокНаНачалоГода_0_12
SUB ОстатокНаНачалоГода_0_12	

	if Month('$(vToday)')>=11 or Month('$(vToday)')=1 THEN	
		//этот скрипт должен запускать с ноября по январь 
		
		if Month('$(vToday)')>=11 THEN
			SET vКоличество = 0;
		ELSE
			SET vКоличество = 1;
		ENDIF
	
	////ДЛЯ ОТЛАДКИ	
	//	LET vДатаОстаток 		= date('30.09.2023');
	//	LET vДата_НачалоГода	= date('01.01.2024');
		
		LET vДатаОстаток		= date(MakeDate(Year('$(vToday)')-'$(vКоличество)',   9, 30));
		LET vДата_НачалоГода	= date(MakeDate(Year('$(vToday)')-'$(vКоличество)'+1, 1, 1));
		
		LET vГОД				= Year('$(vДатаОстаток)');
		LET vГОД_НачалоГода		= Year('$(vДата_НачалоГода)');
	
	
		Остатки_ДЗ:
		LOAD 
		     Year(Дата) 														as Год,
		     [Строка Тип]														as [Прогноз.Признак],
		     'На начало окт '&Year(Дата)										as [Прогноз.Сценарий],
		     [ДО Наименование],  
		     date(DayStart(MonthEnd(Дата))) 									as Дата,  
		     sum([Задолженность Общая (за вычетом резервов) переоценка, руб.]) 	as [Прогноз.Сумма]
		FROM
			[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
			(qvd)
		Where 
			[Строка Тип]='ДЗ'		and
			Дата='$(vДатаОстаток)' 	and
			Exists(ДО_Список, [ДО Наименование])	 //только ДО для ВОК
		Group By 
			 [ДО Наименование],  
		     Дата,
		     [Строка Тип];     
		
		
		//**************************************************** ДЗ ПОСТУПЛЕНИЯ
		Concatenate (Остатки_ДЗ)
		LOAD 
		     Year(Период) 							as Год,
		     'ДЗ' 									as [Прогноз.Признак],
			 'Поступления окт-дек '&Year(Период) 	as [Прогноз.Сценарий],
		     ДО 									as [ДО Наименование], 
		     date(DayStart(MonthEnd(Период))) 		as Дата, 
		     sum([Сумма план-факт]*1000000)*(-1) 	as [Прогноз.Сумма], //в сиходнике суммы в миллионах
		     Группа2								as Детали
		FROM
			[$(vDataTier3)\Контроль БДДС\Дашборд Контроль БДДС\Данные.qvd]
			(qvd)
		Where 
			Exists(ДО_Список, [ДО]) 								and //только ДО
			ДО<>'БРД' 												and
			[Отчетный период]='9+3' 								and
			date(DayStart(MonthEnd(Период)))>'$(vДатаОстаток)' 		and  
			date(DayStart(MonthEnd(Период)))<'$(vДата_НачалоГода)'	and
			WildMatch(Группа2, 	'Поступления от реализации - прочие (3и лица)',
								'Поступления от реализации газа (3и лица)',
								'Поступления от реализации нефти (3и лица)',
								'Поступления от реализации н/п (3и лица)'
								)
		Group By
			 ДО, 
		     [Отчетный период],  
		     Год, 
		     Период,
		     Группа2;
		     	
		
		
		//**************************************************** ДЗ ВЫРУЧКА	
		Concatenate (Остатки_ДЗ)
		LOAD 
		     Year(Дата) 					as Год,
		     'ДЗ' 							as [Прогноз.Признак],
			 'Выручка окт-дек '&Year(Дата) 	as [Прогноз.Сценарий],
		     entity_ALIAS2 					as [ДО Наименование], 
		     date(DayStart(MonthEnd(Дата))) as Дата, 
		     fabs(sum(Данные*1000)*1.2) 	as [Прогноз.Сумма],
		     if(account_ALIAS='Выручка от реализации ТМЦ', account_ALIAS, if(not account like 'ACC_PL_17*', account_ALIAS)) as Детали
		FROM
			[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
			(qvd)
		Where 
			Exists(ДО_Список, entity_ALIAS2)	 												and //только ДО
			scenario='SCN_FORECAST_09' 															and
			date(DayStart(MonthEnd(Дата)))>'$(vДатаОстаток)' 									and  
			date(DayStart(MonthEnd(Дата)))<'$(vДата_НачалоГода)'								and
			
			((KA_VGO_FLAG='KA' 																	and
			counterparty<>'CT_TOTAL' 															and
			counterparty<>'CT_TOTAL_ALT'														and
			account_ALIAS like 'Выручка*' 														and
			if(account_ALIAS='Выручка от реализации ТМЦ', 1=1, not account like 'ACC_PL_17*') 	
			)		
	
			OR
			
			(account_ALIAS like 'Выручка*' 														and
			counterparty_ALIAS='ОЕ Поставка нефти_ГПН (к)' 										and
			WildMatch(entity_ALIAS2, 'Томскнефть', 'Мессояха', 'Мегион')
			))
	
		Group By
			 Год, 
		     scenario, 
		     entity_ALIAS2, 
		     Дата,
		     account_ALIAS,
		     account;	
		
		
		//**************************************************** СОХРАНЕНИЕ ИТОГА КАК НАЧАЛО СЛЕДУЮЩЕГО ГОДА
		NoConcatenate
		ИТОГ:
		LOAD
			[Прогноз.Признак],
			[ДО Наименование],  
			MakeDate((Год+1), 1, 1) as Дата,
			sum([Прогноз.Сумма]) 	as [Прогноз.Сумма]
		Resident 
			Остатки_ДЗ 
		Where 
			Год='$(vГОД)'
		Group By 
			[Прогноз.Признак],
			[ДО Наименование],
			Год;	
		
		IF not WildMatch(Upper(ComputerName()),'SPB99-BRD-QV0*T*','SPB99-BRD-QV0*D*') THEN
			STORE ИТОГ into $(vXLSData_UFK)\_УФК БРД_общие данные\Приложения Qlik\Управление ВОК\ВОК\Остатки на начало года\ОстатокДЗ_прогноз_01_$(vГОД_НачалоГода).qvd;
		ENDIF
		
		STORE ИТОГ into $(vDataTier3)\Дашборд ВОК\Прогноз\Остатки на начало\ОстатокДЗ_прогноз_01_$(vГОД_НачалоГода).qvd;
		DROP Table Остатки_ДЗ;
		DROP Table ИТОГ;

	ENDIF

ENDSUB
///$tab Прогноз_Итог
SUB Прогноз_Итог
	
	//прогнозы на начало 2021 и 2022 года - не изменятся. поэтому беру с сетевой папки
	[Прогноз Данные]:
	LOAD 
		 '0+12' 							as [Прогноз.Сценарий],
	     [ДО Наименование], 
	     date(DayStart(MonthEnd((Дата+1)))) as Дата, 
	     Year(Дата+1) 						as Год,
	     Round(Прогноз.Сумма) 				as Прогноз.Сумма,
	     0 									as [Признак наличия факта]
	FROM
		[$(vDataTier3)\Дашборд ВОК\Прогноз\Остатки на начало\ОстатокДЗ_прогноз_01_202*.qvd]
		(qvd);	
	
ENDSUB
///$tab ДЗ факт
SUB ДЗ_факт	
	
	Concatenate ([Прогноз Данные])
	LOAD * Where [Прогноз.Сценарий]<>'12+0';
	LOAD 
		 text((Num(Month(Дата))&'+'&Num(12-Month(Дата)))) 					as [Прогноз.Сценарий],
	     [ДО Наименование],  
	     Year(AddMonths(Дата,+1)) 											as Год,
	     date(DayStart(MonthEnd(AddMonths(Дата,+1)))) 						as Дата,  
	     sum([Задолженность Общая (за вычетом резервов) переоценка, руб.]) 	as [Прогноз.Сумма],
	     0 																	as [Признак наличия факта]
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
		(qvd)
	Where 
		[Строка Тип]='ДЗ' 			and
		Exists(ДО_Список, [ДО Наименование])	 //только ДО
	Group By 
		 [ДО Наименование],  
	     Дата;

ENDSUB
///$tab ВсеПериоды
SUB ВсеПериоды

	Сценарии:
	LOAD 
		Значение as Прогноз.Сценарий
	FROM [$(vDataTier1)\Excel\Контроль БДДС\Справочники\Сценарии.qvd] (qvd);
	
	
	Left Join (Сценарии)
	[Прогноз Месяцы]:
	LOAD
		Год,
		Период as Дата
	FROM
		[$(vDataTier1)\Excel\Дашборд ВОК\Периоды.qvd](qvd);
	
	Left Join (Сценарии)
	LOAD Distinct [ДО Наименование] Resident [Прогноз Данные];
	
	NoConcatenate
	Сценарии_:
	LOAD
		[ДО Наименование],
		[Прогноз.Сценарий],
		Дата,
		Год,
		if(ApplyMap('ПорядокОтчетности_Сортировка', [Прогноз.Сценарий])>=Month(Дата), 1,0) as [Признак наличия факта]
	Resident 
		Сценарии;
	DROP Table Сценарии;

ENDSUB
///$tab ДЗ поступления
//для СП, которые на факторинге необходимо для ВОКа при расчете прогноза Выручку и поступления делить на 2

SUB ДЗ_поступления
	
	NoConcatenate
	t1:
	LOAD * Resident Сценарии_;
	
	Left Join (t1)
	LOAD
		[ДО Наименование], 
		[Прогноз.Сценарий],  
		Дата, 
		[Признак наличия факта],
		sum([Прогноз.Сумма.Поступления]) as [Прогноз.Сумма.Поступления]
	Group by 
		[ДО Наименование], 
		[Прогноз.Сценарий],  
		Дата, 
		[Признак наличия факта];
	LOAD 
	     Год,
	     ДО 								as [ДО Наименование], 
	     [Отчетный период] 					as [Прогноз.Сценарий],  
	     date(DayStart(MonthEnd(Период))) 	as Дата, 
	     [Признак наличия факта],
	     Группа2,
	     (if(wildmatch(Группа2,'Поступления от реализации нефти (3и лица)') 
		 and WildMatch(ДО, 'Томскнефть', 'Мессояха', 'Мегион'),
		     fabs(sum([Сумма план-факт]*1000000))/2,
		     fabs(sum([Сумма план-факт]*1000000)))) 	as [Прогноз.Сумма.Поступления] //в исходнике суммы в миллионах
	FROM
		[$(vDataTier3)\Контроль БДДС\Дашборд Контроль БДДС\Данные.qvd]
		(qvd)	
	Where 
		Exists(ДО_Список, [ДО]) 							and //только ДО
		ДО<>'БРД' 											and
		Год>=2022											and
		WildMatch(Группа2, 	'Поступления от реализации - прочие (3и лица)',
							'Поступления от реализации газа (3и лица)',
							'Поступления от реализации нефти (3и лица)',
							'Поступления от реализации н/п (3и лица)'
							)
		and [Отчетный период]<>'0+12 акт'
	Group By
		 Группа2,
		 ДО, 
	     [Отчетный период],  
	     [Признак наличия факта],
	     Период,
	     Год;
		
	Outer Join ([Прогноз Данные])
	LOAD * Resident t1;
	DROP Table t1;
	
ENDSUB
///$tab ДЗ выручка
//для СП, которые на факторинге необходимо для ВОКа при расчете прогноза Выручку и поступления делить на 2

SUB ДЗ_выручка
	
	ТаблицаСоответствияСценариев:
	LOAD
		Год,
		[Сценарий факт исходный СПО],
		[Сценарий Эталон] as [Прогноз.Сценарий]
	FROM [$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\ТаблицаСоответствияСценариев.qvd] (qvd);
	
	Inner Join (ТаблицаСоответствияСценариев)
	LOAD 
		 Год,
	     scenario 						as [Сценарий факт исходный СПО], 
	     entity_ALIAS2 					as [ДО Наименование], 
	     date(DayStart(MonthEnd(Дата))) as Дата, 
     	 fabs(sum(Данные)*1000)*1.2 	as [Прогноз.Сумма.Выручка]     	 
	FROM
		[$(vDataTier2)\FactTables\Контроль БДДС\КЛАД\Данные_spo_Исходник для прогноза.qvd]
		(qvd)
	Where 
		Exists(ДО_Список, entity_ALIAS2)	 												and //только ДО
		Год>=2022																			and
		(KA_VGO_FLAG='KA' 																	and
		counterparty<>'CT_TOTAL' 															and
		counterparty<>'CT_TOTAL_ALT' 														and
		account_ALIAS like 'Выручка*' 														and
		if(account_ALIAS='Выручка от реализации ТМЦ', 1=1, not account like 'ACC_PL_17*')) 
	Group By
		 Год, 
	     scenario, 
	     entity_ALIAS2, 
	     Дата;	
	DROP Field [Сценарий факт исходный СПО];
	
	NoConcatenate
	t1:
	LOAD * Resident Сценарии_;
	
	Left Join (t1)
	LOAD 
		* ,
		if(ApplyMap('ПорядокОтчетности_Сортировка', [Прогноз.Сценарий])>=Month(Дата), 1,0) as [Признак наличия факта]
	Resident ТаблицаСоответствияСценариев;
	DROP Table ТаблицаСоответствияСценариев;
	
	DROP Table ДО_Список;
	
	Outer Join ([Прогноз Данные])
	LOAD * Resident t1;
	DROP Table t1;
	DROP Table Сценарии_;
	
ENDSUB
///$tab Генерация прогноза
sub Прогноз

	NoConcatenate
	t1:
	LOAD
	*,
	if([ДО Наименование]=Previous([ДО Наименование]) and [Прогноз.Сценарий]=Previous([Прогноз.Сценарий]) and Год=Previous(Год),
			Rangesum(peek('Прогноз'), [Прогноз.Сумма.Выручка],-[Прогноз.Сумма.Поступления]),
			Rangesum(0,	   			  [Прогноз.Сумма],[Прогноз.Сумма.Выручка],-[Прогноз.Сумма.Поступления])) as Прогноз;
	LOAD
		[Прогноз.Сценарий],
		[ДО Наименование],  
		Год,
		Дата,  
		[Прогноз.Сумма],
		[Признак наличия факта],
		RangeSum(0, [Прогноз.Сумма.Поступления]) as [Прогноз.Сумма.Поступления],
		RangeSum(0, [Прогноз.Сумма.Выручка]) as [Прогноз.Сумма.Выручка]
	Resident 
		[Прогноз Данные]
	Where 
		[Признак наличия факта]=0
	Order By
		[ДО Наименование], 
		Год,
		[Прогноз.Сценарий],
		Дата asc;

	DROP Table [Прогноз Данные];

	NoConcatenate
	Прогноз:
	LOAD 
		[Прогноз.Сценарий],
		[ДО Наименование],  
		Год,
		Дата,  
		Прогноз
	Resident t1 Where Прогноз<>0;

	STORE Прогноз into $(vDataTier3)\Дашборд ВОК\Прогноз\Прогноз_ДЗ.qvd;
	DROP Table Прогноз;	
	
ENDSUB
///$tab CALLs
CALL ServiceTBLs
CALL MapTBLs
CALL ОстатокНаНачалоГода_0_12

CALL Прогноз_Итог
CALL ДЗ_факт

CALL ВсеПериоды
CALL ДЗ_поступления
CALL ДЗ_выручка
CALL Прогноз
