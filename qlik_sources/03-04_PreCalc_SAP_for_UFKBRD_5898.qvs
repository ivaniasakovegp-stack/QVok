///$tab Main
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\regionvars.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\folders.qvs);
$(must_include=..\..\QVScripts\QVS\Variables\Дашборд ВОК\vars.qvs);
///$tab MapTBLs
SUB MapTBLs

	ДО_ВОК:
	LOAD Distinct     
	     [БЕ Код],
	     Наименование as ДО_ВОК
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd);
	
	ТИП_ДО:
	mapping
	LOAD Distinct     
	     [ДО Кратко],
	     [ТИП ДО]
	FROM 
		[$(vDataTier1)\Excel\Дашборд ВОК\ДО_ВОК.qvd]
		(qvd)
	Where
		 [ТИП ДО]<>'' and not isNull([ТИП ДО]);
	
ENDSUB
///$tab АРМ КК
SUB АРМ_КК

	АРМ_КК_Данные:
	LOAD
		*
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\АРМ КК\АРМ_КК_Данные.qvd]
		(qvd)
	Where 
	 	not IsNull([ДО Наименование]); //оставляю только ДО для ВОК;
	
ENDSUB

///$tab МТР
SUB МТР

	МТР_Данные:
	LOAD
		*
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\МТР\МТР_Данные.qvd]
		(qvd);

ENDSUB

///$tab ДЗ
SUB ДЗ

	///////////////////////////////////////// ДЗ НА КОНЕЦ
	Данные:
	LOAD
		[Источник данных],
		Дата, 
		[ДО Наименование], 
		[Контрагент Наименование],
		'ВОК' 																as Лист,
		'УО' 																as [Признак УО/МСФО],
		'ДЗ на конец' 														as [Признак Данные],
		sum([Задолженность Общая (за вычетом резервов) переоценка, руб.]) 	as Сумма
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='ДЗ'
	Group By
		[Источник данных],
		Дата, 
		[ДО Наименование],
		[Контрагент Наименование];
	
	///////////////////////////////////////// ДЗ НА НАЧАЛО
	Concatenate (Данные)
	LOAD
		[Источник данных],
		date(DayStart(MonthEnd(AddMonths(Дата,1)))) 						as Дата, 
		[ДО Наименование], 
		'ВОК' 																as Лист,
		'УО' 																as [Признак УО/МСФО],
		'ДЗ на начало' 														as [Признак Данные],
		sum([Задолженность Общая (за вычетом резервов) переоценка, руб.]) 	as Сумма
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='ДЗ'
	Group By
		[Источник данных],
		Дата, 
		[ДО Наименование];
	
ENDSUB

///$tab Авансы
SUB Авансы

	///////////////////////////////////////// АВАНСЫ НА НАЧАЛО
	Concatenate (Данные)
	LOAD
		[Источник данных],
		Дата, 
		[ДО Наименование], 
		'ВОК' 																	as Лист,
		'УО' 																	as [Признак УО/МСФО],
		'Авансы на начало' 														as [Признак Данные],
		sum([Авансы Сумма на начало периода (без отрицательных сальдо), руб.]) 	as Сумма
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='Авансы'
	Group By
		[Источник данных],
		Дата, 
		[ДО Наименование];
	
	///////////////////////////////////////// АВАНСЫ НА КОНЕЦ
	Concatenate (Данные)
	LOAD
		[Источник данных],
		Дата, 
		[ДО Наименование], 
		[Контрагент Наименование],
		'ВОК' 																	as Лист,
		'УО' 																	as [Признак УО/МСФО],
		'Авансы на конец' 														as [Признак Данные],
		sum([Авансы Сумма на конец периода (без отрицательных сальдо), руб.]) 	as Сумма,
		[Задолженность Тип] 													as [Фильтр в Карте МТР 1 уровень]
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='Авансы'
	Group By
		[Источник данных],
		Дата, 
		[ДО Наименование],
		[Контрагент Наименование],
		[Задолженность Тип],
		[Обеспечение признак наличия];
	
	///////////////////////////////////////// АВАНСЫ НЕОБЕСПЕЧЕННЫЕ
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[Контрагент Наименование],
		Дата, 
		[ДО Наименование], 
		'ВОК' 								as Лист,
		'УО' 								as [Признак УО/МСФО],
		'Авансы необеспеченные' 			as [Признак Данные],
		sum([Сумма без обеспечения, руб.]) 	as Сумма
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='Авансы'
	Group By
		[Источник данных],
		[Контрагент Наименование],
		Дата, 
		[ДО Наименование];

ENDSUB

///$tab ПДЗ
SUB ПДЗ

	///////////////////////////////////////// ПДЗ НА КОНЕЦ
	Concatenate (Данные)
	LOAD
		[Источник данных],
		Дата, 
		[ДО Наименование], 
		'ВОК' 												as Лист,
		'УО' 												as [Признак УО/МСФО],
		'ПДЗ на конец' 										as [Признак Данные],
		sum([Задолженность Просроченная переоценка, руб.]) 	as Сумма
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='ДЗ'
	Group By
		[Источник данных],
		Дата, 
		[ДО Наименование];
	
	///////////////////////////////////////// ПДЗ НА КОНЕЦ >30 дней
	Concatenate (Данные)
	LOAD
		[Источник данных],
		Дата, 
		[ДО Наименование], 
		'ВОК' 												as Лист,
		'УО' 												as [Признак УО/МСФО],
		'ПДЗ на конец > 30 дней'							as [Признак Данные],
		sum([Задолженность просроченная (>30 дней) переоценка, руб.]) 	as Сумма
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='ДЗ'
	Group By
		[Источник данных],
		Дата, 
		[ДО Наименование];
	
	///////////////////////////////////////// ПДЗ НА КОНЕЦ >5 дней (как сумма >5<=30 и >30)
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[Контрагент Наименование],
		Дата, 
		[ДО Наименование], 
		'ВОК' 												as Лист,
		'УО' 												as [Признак УО/МСФО],
		'ПДЗ на конец > 5 дней'								as [Признак Данные],
		RangeSum(0,sum([Задолженность просроченная (>30 дней) переоценка, руб.]), 
				   sum([Задолженность просроченная (>5 и <=30 дней) переоценка, руб.])) 	as Сумма
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='ДЗ'
	Group By
		[Источник данных],
		[Контрагент Наименование],
		Дата, 
		[ДО Наименование];

ENDSUB

///$tab КЗ
SUB КЗ

	///////////////////////////////////////// КЗ НА НАЧАЛО
	Concatenate (Данные)
	LOAD
		[Источник данных],
		Дата, 
		[ДО Наименование], 
		'ВОК' 															as Лист,
		'УО' 															as [Признак УО/МСФО],
		'КЗ на начало' 													as [Признак Данные],
		sum([КЗ на начало периода (без отрицательных сальдо), руб.]) 	as Сумма
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='КЗ'
	Group By
		[Источник данных],
		Дата, 
		[ДО Наименование];	
	
	///////////////////////////////////////// КЗ НА КОНЕЦ
	Concatenate (Данные)
	LOAD
		[Источник данных],
		Дата, 
		[ДО Наименование],
		[Контрагент Наименование], 
		'ВОК' 														as Лист,
		'УО' 														as [Признак УО/МСФО],
		'КЗ на конец' 												as [Признак Данные],
		sum([КЗ на конец периода (без отрицательных сальдо), руб.]) as Сумма,
		[Задолженность Тип] 										as [Фильтр в Карте МТР 1 уровень]
	Resident 
		АРМ_КК_Данные
	Where 
		[Строка Тип]='КЗ'
	Group By
		[Источник данных],
		Дата, 
		[ДО Наименование],
		[Контрагент Наименование],
		[Задолженность Тип];
	
ENDSUB

///$tab АвансыКИсключению
SUB АвансыКИсключению	
	
	///////////////////////////////////////// АВАНСЫ НА НАЧАЛО, КОТОРЫЕ ТРЕБУЕТСЯ ИСКЛЮЧИТЬ ИЗ ОБОРАЧИВАЕМОСТИ КЗ
	Concatenate (Данные)
	LOAD  
	     [Источник данных],	     
	     Дата,     
	     [ДО Наименование], 
		'ВОК' 														 as Лист,
		'УО' 														 as [Признак УО/МСФО],
		'Авансы к исключению на начало' 							 as [Признак Данные],
		sum([КЗ на начало периода (без отрицательных сальдо), руб.]) as Сумма,
		[Задолженность Тип] 										 as [Фильтр в Карте МТР 1 уровень]
	Resident
		АРМ_КК_Данные
	Where 
		[Строка Тип]='КЗ' and
		([Бухгалтерский счет] like '62.*' or [Бухгалтерский счет] like '624*')
	Group By
		[Источник данных],	     
	    Дата,     
	    [ДО Наименование],
		[Задолженность Тип];
	
	///////////////////////////////////////// АВАНСЫ НА НАЧАЛО, КОТОРЫЕ ТРЕБУЕТСЯ ИСКЛЮЧИТЬ ИЗ ОБОРАЧИВАЕМОСТИ КЗ
	Concatenate (Данные)
	LOAD  
	     [Источник данных],	     
	     Дата,     
	     [ДО Наименование], 
		'ВОК' 														as Лист,
		'УО' 														as [Признак УО/МСФО],
		'Авансы к исключению на конец' 								as [Признак Данные],
		sum([КЗ на конец периода (без отрицательных сальдо), руб.]) as Сумма,
		[Задолженность Тип] 										as [Фильтр в Карте МТР 1 уровень]
	Resident
		АРМ_КК_Данные
	Where 
		[Строка Тип]='КЗ' and
		([Бухгалтерский счет] like '62.*' or [Бухгалтерский счет] like '624*')
	Group By
		[Источник данных],	     
	    Дата,     
	    [ДО Наименование],
		[Задолженность Тип];
	

ENDSUB

///$tab АвансыНорд
SUB АвансыНорд

	///////////////////////////////////////// АВАНСЫ НА НАЧАЛО, КОТОРЫЕ ТРЕБУЕТСЯ ИСКЛЮЧИТЬ ИЗ ОБОРАЧИВАЕМОСТИ КЗ
	Concatenate (Данные)
	LOAD  
	     [Источник данных],	     
	     Дата,     
	     [ДО Наименование], 
		 [Контрагент Наименование],
		'ВОК' 														as Лист,
		'УО' 														as [Признак УО/МСФО],
		'Авансы Норд в адрес Ямал' 									as [Признак Данные],
		sum([КЗ на конец периода (без отрицательных сальдо), руб.]) as Сумма
	Resident
		АРМ_КК_Данные
	Where 
		([Строка Тип]='КЗ' 				and
		[ДО Наименование]='Ямал' 	and
		[Бухгалтерский счет] like '624*')
		or
		([Строка Тип]='КЗ' 				and
		[ДО Наименование]='Ангара' 	and
		[Бухгалтерский счет] = '62.02' and
		[Контрагент ИНН]='7604105513')
	Group By
		[Источник данных],	     
	    Дата,     
	    [ДО Наименование],
		[Контрагент Наименование];
	
	DROP Table АРМ_КК_Данные;

ENDSUB


///$tab МТР_СУчВНА
SUB МТР_СУчВНА

	///////////////////////////////////////// ЗАПАС МТР НА НАЧАЛО ФАКТ
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование],
		Период 											as Дата, 		 
		'ВОК' 											as Лист,
		'УО' 											as [Признак УО/МСФО],
		'Запас МТР на начало' 							as [Признак Данные],
		sum(Сумма) 										as Сумма,
		'МТР с учетом ВНА' 								as [Признак МТР]
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull(Сумма) and
		[Признак Данные]='Запас МТР на начало'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование];
		
	///////////////////////////////////////// ЗАПАС МТР НА КОНЕЦ ФАКТ
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование], 
		Период 											as Дата, 		
		'ВОК' 											as Лист,
		'УО' 											as [Признак УО/МСФО],
		'Запас МТР на конец' 							as [Признак Данные],
		sum(Сумма) 										as Сумма,
		'МТР с учетом ВНА' 								as [Признак МТР],
		Проект,
		[Фильтр в Карте МТР 1 уровень]	
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull (Сумма) and
		[Признак Данные]='Запас МТР на конец'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование],
		Проект,
		[Фильтр в Карте МТР 1 уровень];

ENDSUB

///$tab МТР_СУчВНА_План
SUB МТР_СУчВНА_План

	///////////////////////////////////////// ЗАПАС МТР НА НАЧАЛО ФАКТ
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование],
		Период 											as Дата, 		 
		'ВОК' 											as Лист,
		'УО' 											as [Признак УО/МСФО],
		'Норматив Запас МТР на начало' 					as [Признак Данные],
		sum(Сумма) 										as Сумма,
		'МТР с учетом ВНА' 								as [Признак МТР]
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull(Сумма) and
		[Признак Данные]='Норматив Запас МТР на начало'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование];
		
	///////////////////////////////////////// ЗАПАС МТР НА КОНЕЦ ФАКТ
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование], 
		Период 											as Дата, 		
		'ВОК' 											as Лист,
		'УО' 											as [Признак УО/МСФО],
		'Норматив Запас МТР на конец' 					as [Признак Данные],
		sum(Сумма) 										as Сумма,
		'МТР с учетом ВНА' 								as [Признак МТР],
		Проект	
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull (Сумма) and
		[Признак Данные]='Норматив Запас МТР на конец'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование],
		Проект;
	
ENDSUB

///$tab МТР_Расход
SUB МТР_Расход

	///////////////////////////////////////// РАСХОД МТР ЗА ПЕРИОД (с уч ВНА)
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование], 
		Период 														as Дата, 		
		'ВОК' 														as Лист,
		'УО' 														as [Признак УО/МСФО],
		'Расход МТР за период' 										as [Признак Данные],
		Fabs(sum(Сумма)) 											as Сумма,
		[Признак НЭЗ],
		'МТР с учетом ВНА' 											as [Признак МТР]
	Resident 
		МТР_Данные
	Where	
		Сумма<>0 and not IsNull(Сумма) and
		[Признак Данные]='РасходКорр'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование],
		[Признак НЭЗ];
	
	///////////////////////////////////////// РАСХОД МТР ЗА ПЕРИОД (без уч ВНА)
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование], 
		Период 														as Дата, 		
		'ВОК' 														as Лист,
		'УО' 														as [Признак УО/МСФО],
		'Расход МТР за период' 										as [Признак Данные],
		Fabs(sum(Сумма)) 											as Сумма,
		[Признак НЭЗ],
		'МТР без учета ВНА' 										as [Признак МТР]
	Resident 
		МТР_Данные
	Where	
		[МТР признак ВНА] = 'БЕЗ ВНА' 	and
		Сумма<>0 and not IsNull(Сумма)  and
		[Признак Данные]='РасходКорр'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование],
		[Признак НЭЗ];

	///////////////////////////////////////// РАСХОД МТР ЗА ПЕРИОД (с уч ВНА) Годовой. Собран в отдельном приложении  00-Бенчмарк
	Concatenate (Данные)
	LOAD 
		'МТР' 									as [Источник данных],
		'ВОК' 									as Лист,
		'УО' 									as [Признак УО/МСФО],
		'Расход МТР за период Годовой' 			as [Признак Данные],
		[ДО Наименование], 
		Период 									as Дата, 
		Данные 									as Сумма,
		'МТР с учетом ВНА' 						as [Признак МТР]
	FROM
		[$(vDataTier3)\Дашборд ВОК\Прогноз\МТР_ВовлечениеГод.qvd]
		(qvd)
	Where	
		[Признак Данные]='Норматив Расход';

	///////////////////////////////////////// РАСХОД МТР ЗА ПЕРИОД норматив (с уч ВНА)
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование], 
		Период 														as Дата, 		
		'ВОК' 														as Лист,
		'УО' 														as [Признак УО/МСФО],
		'Норматив Расход МТР за период' 							as [Признак Данные],
		Fabs(sum(Сумма)) 											as Сумма,
		'МТР с учетом ВНА' 											as [Признак МТР]
	Resident 
		МТР_Данные
	Where	
		Сумма<>0 and not IsNull(Сумма) and
		[Признак Данные]='Норматив Расход'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование];
	


ENDSUB

///$tab МТР_Приход_План_Факт
SUB МТР_Приход_План_Факт

	///////////////////////////////////////// ПРИХОД МТР ЗА ПЕРИОД норматив
	Concatenate (Данные)
	LOAD  
	    [Источник данных],
	    [ДО Наименование], 
	    Период														as Дата, 
	    sum(Сумма)	 												as Сумма,
		'Норматив Приход МТР за период' 							as [Признак Данные]
	Resident 
		МТР_Данные
	Where 
		Сумма<>0 and not IsNull(Сумма) and
		[Признак Данные]='Норматив Приход'
		and Year(Период)>2020
	Group By 
		[Источник данных],
		[ДО Наименование], 
	    Период;
	
	///////////////////////////////////////// ПРИХОД МТР ЗА ПЕРИОД Факт
	Concatenate (Данные)
	LOAD  
	    [Источник данных],
	    [ДО Наименование], 
	    Период														as Дата, 
	    sum(Сумма)	 												as Сумма,
		'Приход МТР за период' 										as [Признак Данные],
		'МТР с учетом ВНА' 											as [Признак МТР],
		'УО' 														as [Признак УО/МСФО]
	Resident 
		МТР_Данные
	Where 
		Сумма<>0 and not IsNull(Сумма) and
		[Признак Данные]='Приход'
		and Year(Период)>2020
	Group By 
		[Источник данных],
		[ДО Наименование], 
	    Период;

		///////////////////////////////////////// ПРИХОД МТР ЗА ПЕРИОД (с уч ВНА) Годовой. Собран в отдельном приложении  00-Бенчмарк
	Concatenate (Данные)
	LOAD 
		'МТР' 									as [Источник данных],
		'ВОК' 									as Лист,
		'УО' 									as [Признак УО/МСФО],
		'Приход МТР за период Годовой' 			as [Признак Данные],
		[ДО Наименование], 
		Период 									as Дата, 
		Данные 									as Сумма,
		'МТР с учетом ВНА' 						as [Признак МТР]
	FROM
		[$(vDataTier3)\Дашборд ВОК\Прогноз\МТР_ВовлечениеГод.qvd]
		(qvd)
	Where	
		[Признак Данные]='Норматив Приход';

ENDSUB

///$tab МТР_НЭЗ
SUB МТР_НЭЗ

	///////////////////////////////////////// НЭЗ на конец Включая оборудование
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование], 
		Период 										as Дата, 		
		'ВОК' 										as Лист,
		'УО' 										as [Признак УО/МСФО],
		'НЭЗ МТР на конец' 							as [Признак Данные],
		sum(Сумма) 									as Сумма,
		'МТР с учетом ВНА' 							as [Признак МТР],
		Проект,
		if([НЭЗ по сроку хранения]='Более трёх', 1, 0) as [Признак НЭЗ больше 3 лет в запасе]
	Resident 
		МТР_Данные
	Where
		[Признак НЭЗ]=1 				and
		Сумма<>0 and not IsNull(Сумма) 	and
		[Признак Данные]='Запас МТР на конец'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование],
		Проект,
		if([НЭЗ по сроку хранения]='Более трёх', 1, 0);
	
	///////////////////////////////////////// НЭЗ на конец НЕ включая оборудовние
	Concatenate (Данные)
	LOAD
		[Источник данных],
		[ДО Наименование], 
		Период 										as Дата, 		
		'ВОК' 										as Лист,
		'УО' 										as [Признак УО/МСФО],
		'НЭЗ МТР на конец' 							as [Признак Данные],
		sum(Сумма) 									as Сумма,
		'МТР без учета ВНА' 						as [Признак МТР],
		Проект,
		if([НЭЗ по сроку хранения]='Более трёх', 1, 0) as [Признак НЭЗ больше 3 лет в запасе]
	Resident 
		МТР_Данные
	Where
		[МТР признак ВНА] = 'БЕЗ ВНА' 	and
		[Признак НЭЗ]=1 				and
		Сумма<>0 and not IsNull(Сумма) 	and
		[Признак Данные]='Запас МТР на конец'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование],
		Проект,
		if([НЭЗ по сроку хранения]='Более трёх', 1, 0);
		
	
	///////////////////////////////////////// НЭЗ на конец Включая оборудование ПРОГНОЗ НА КОНЕЦ ГОДА
	Concatenate (Данные)
	LOAD 
	    [ДО Наименование], 
		MakeDate(Left([Срез данных],4), 12,31) as Дата,
		'ВОК' 										as Лист,
		'УО' 										as [Признак УО/МСФО],
		'НЭЗ МТР на конец Прогноз' 					as [Признак Данные],
		sum(Сумма) 									as Сумма
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull(Сумма) 	and
		[Признак Данные]='Прогноз НЭЗ МетодПост' and
		WildMatch([Срез данных],'202303. БП', '202403. БП', '202503. БП') //плохо, что здесь конкретный перечень
	Group By
		[Срез данных],
		[ДО Наименование];
	
	
ENDSUB

///$tab МТР_БезУчВНА
SUB МТР_БезУчВНА

	///////////////////////////////////////// ЗАПАС МТР НА КОНЕЦ (без учета ВНА)
	Concatenate (Данные)
	LOAD 
		 [Источник данных],
		 'ВОК' 														as Лист,
		 'УО' 														as [Признак УО/МСФО],
		 'Запас МТР на конец' 										as [Признак Данные],
		 Период 													as Дата, 
	     [ДО Наименование], 
	     sum(Сумма)													as Сумма,
	     'МТР без учета ВНА' 										as [Признак МТР],
		 Проект
	Resident 
		МТР_Данные
	Where
		[МТР признак ВНА] = 'БЕЗ ВНА' 	and	
		Сумма<>0 and not IsNull(Сумма) 	and
		[Признак Данные]='Запас МТР на конец'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование],
		Проект;
	
	///////////////////////////////////////// ЗАПАС МТР НА НАЧАЛО (без учета ВНА)
	Concatenate (Данные)
	LOAD 
		 [Источник данных],
		 'ВОК' 														as Лист,
		 'УО' 														as [Признак УО/МСФО],
		 'Запас МТР на начало' 										as [Признак Данные],
		 Период 													as Дата, 
	     [ДО Наименование], 
	     sum(Сумма)							 						as Сумма,
	     'МТР без учета ВНА' 										as [Признак МТР]
	Resident 
		МТР_Данные
	Where
		[МТР признак ВНА] = 'БЕЗ ВНА' 	and
		Сумма<>0 and not IsNull(Сумма) 	and
		[Признак Данные]='Запас МТР на начало'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование];
	
ENDSUB

///$tab МТР_БезУчВНА_План
SUB МТР_БезУчВНА_План

	///////////////////////////////////////// ЗАПАС МТР НА КОНЕЦ (без учета ВНА)
	Concatenate (Данные)
	LOAD 
		 [Источник данных],
		 'ВОК' 														as Лист,
		 'УО' 														as [Признак УО/МСФО],
		 'Норматив Запас МТР на конец' 								as [Признак Данные],
		 Период 													as Дата, 
	     [ДО Наименование], 
	     sum(Сумма)													as Сумма,
	     'МТР без учета ВНА' 										as [Признак МТР],
		 Проект
	Resident 
		МТР_Данные
	Where
		[МТР признак ВНА] = 'БЕЗ ВНА' 	and
		Сумма<>0 and not IsNull(Сумма) 	and
		[Признак Данные]='Норматив Запас МТР на конец'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование],
		Проект;
	
	///////////////////////////////////////// ЗАПАС МТР НА НАЧАЛО (без учета ВНА)
	Concatenate (Данные)
	LOAD 
		 [Источник данных],
		 'ВОК' 														as Лист,
		 'УО' 														as [Признак УО/МСФО],
		 'Норматив Запас МТР на начало' 							as [Признак Данные],
		 Период 													as Дата, 
	     [ДО Наименование], 
	     sum(Сумма)							 						as Сумма,
	     'МТР без учета ВНА' 										as [Признак МТР]
	Resident 
		МТР_Данные
	Where
		[МТР признак ВНА] = 'БЕЗ ВНА' 	and
		Сумма<>0 and not IsNull(Сумма) 	and
		[Признак Данные]='Норматив Запас МТР на начало'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование];
	
ENDSUB

///$tab Потери
SUB Потери
	
	Concatenate (Данные)
	LOAD 
		[Источник данных],
		Период						as Дата, 
		Материал,
		[Контрагент Код],
		[Контрагент Тип],
		[ДО Наименование],     
		'ВОК' 						as Лист,
		'УО' 						as [Признак УО/МСФО],
		'Потери' 					as [Признак Данные],
		sum(Сумма)		 			as Сумма,
		if([Признак Данные] like 'Доходы*',    'Реализация МТР кредит',
	 	if([Признак Данные] like 'Стоимость*', 'Реализация МТР дебет',  [Признак Данные]))			as [Признак расхода],
		1							as [Потери. Признак ВГО]
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull(Сумма) 	and
		([Признак Данные]='Потери (Инвентаризация)' or 
		 [Признак Данные]='Потери (Списание)' or
		 [Признак Данные]='Резервы кредит' or
		 [Признак Данные]='Прочее выбытие МТР' or
		 [Признак Данные] like 'Доходы*' or
	 	 [Признак Данные] like 'Стоимость*'
		)
	Group By
		[Источник данных],
		Период,
		Материал, 
		[Контрагент Код],
		[Контрагент Тип],
		[ДО Наименование],
		[Признак Данные];	
		
	
	
	//факт финансирования(для вкладки КПЭ)	
	Concatenate (Данные)
	LOAD 
		[Источник данных],
		[Признак Данные],
		Период						as Дата, 
		[ДО Наименование],     
		'ВОК' 						as Лист,
		'УО' 						as [Признак УО/МСФО],
		RangeSum(0,(sum(Сумма)-sum(Сумма)*min([Доля в ГПН]))*-1) as Сумма  //в рублях
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull(Сумма) 	and
		([Признак Данные]='Финансирование'
		)
	Group By
		[Источник данных],
		[Признак Данные],
		[ДО Наименование],
		[Балансовая единица],
		[Период],
		[Контрагент ДДС Код],
		[Контрагент КПС],
		[Доля в ГПН];	
		
	//план финансирования(для вкладки КПЭ)	
	Concatenate (Данные)
	LOAD 
		[Срез данных],
		[Источник данных],
		[Признак Данные],
		date(DayStart(YearEnd('$(vToday)')))		as Дата, 
//		Период as Дата,
		[ДО Наименование],     
		'ВОК' 						as Лист,
		'УО' 						as [Признак УО/МСФО],
		sum(Сумма)			as Сумма  //в рублях
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull(Сумма) 	
		and [Признак Данные]='Лимит финансирования СИП на МТО' 
		and WildMatch([Срез данных], 'БП/СИП 2023', 'БП/СИП 2024')
	Group By
		[Срез данных],
		[Источник данных],
		[Признак Данные],
		[ДО Наименование],
		[Период];	
	
	
	//План потребность по БП (для вкладки КПЭ) - норматив по "Уровень вовлечения МТР"
	Concatenate (Данные)	
	LOAD 
		[Срез данных],
		[Источник данных],
		[Признак Данные],
		date(DayStart(YearEnd('$(vToday)')))		as Дата, 
//		Период as Дата,
		[ДО Наименование],     
		'ВОК' 						as Лист,
		'УО' 						as [Признак УО/МСФО],
		sum(Сумма) as Сумма
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull(Сумма) 	
		and	[Признак Данные]='Потребность в МТР под программу БП/СИП' 
		and WildMatch([Срез данных], 'БП/СИП 2023', 'БП/СИП 2024')
		and ([Фильтр в Карте МТР 1 уровень]='OPEX' or [Фильтр в Карте МТР 1 уровень]='CAPEX')
	Group By
		[Срез данных],
		[Источник данных],
		[ДО Наименование],
		[Признак Данные],
		[Период];

		
ENDSUB

///$tab НВИ_МТР
SUB НВИ_МТР

	//здесь данные по НВИ и НЛИ	(с уч НВА)
	Concatenate (Данные)
	LOAD 
		[Источник данных],
		Период						as Дата, 
		[ДО Наименование],     
		'ВОК' 						as Лист,
		'УО' 						as [Признак УО/МСФО],
		'Запас МТР на конец НВИ'	as [Признак Данные],
		sum(Сумма)		 			as Сумма,
		'МТР с учетом ВНА' 			as [Признак МТР]
	Resident 
		МТР_Данные
	Where
		Сумма<>0 and not IsNull(Сумма) 	and
		([Категория запаса Код]='NV' or [Категория запаса Код]='NL') and
		[Признак Данные]='Запас МТР на конец'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование];	
	
	//здесь данные по НВИ и НЛИ	(без уч НВА)
	Concatenate (Данные)
	LOAD 
		[Источник данных],
		Период						as Дата, 
		[ДО Наименование],     
		'ВОК' 						as Лист,
		'УО' 						as [Признак УО/МСФО],
		'Запас МТР на конец НВИ'	as [Признак Данные],
		sum(Сумма)		 			as Сумма,
		'МТР без учета ВНА' 			as [Признак МТР]
	Resident 
		МТР_Данные
	Where
		[МТР признак ВНА] = 'БЕЗ ВНА' 	and
		Сумма<>0 and not IsNull(Сумма) 	and
		([Категория запаса Код]='NV' or [Категория запаса Код]='NL') and
		[Признак Данные]='Запас МТР на конец'
	Group By
		[Источник данных],
		Период, 
		[ДО Наименование];

	DROP TABLE МТР_Данные;

ENDSUB


///$tab Выручка
SUB Выручка

	/////////////////////////////////////////ВЫРУЧКА ЗА ПЕРИОД
	Concatenate (Данные)
	LOAD 
		 'SAP витрина ZGRCCP410' 		 		as [Источник данных],
	     [ДО Наименование], 
	     Период									as Дата, 
	     'ВОК' 							 		as Лист,
		 'УО' 							 		as [Признак УО/МСФО],
		 'Выручка за период' 			 		as [Признак Данные],
		 fabs(sum([Выручка оборот за период])) 	as Сумма
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\ZGRCCP410\ZGRCCP410_Выручка.qvd]
		(qvd)
	Where [Признак КА Ямал]=0 //исключить искусственно из Выручки для расчета оборачиваемости ДЗ для ГПН-Ямал в декабре 2022 г. сумму по к/а 87992	АО "Норд"
	Group By
		[ДО Наименование],
		Период;
	
	Concatenate (Данные)
	LOAD 
		 'SAP витрина ZKHDCP056_QRY001' 		as [Источник данных],
		 'Мегион' 								as [ДО Наименование], 
		 date(DayStart(MonthEnd(MakeDate(Mid([Финансовый год/период],5,4),Right([Финансовый год/период],2))))) 	as Дата,
		 'ВОК' 							 		as Лист,
		 'УО' 							 		as [Признак УО/МСФО],
		 'Выручка за период' 			 		as [Признак Данные],	 	 
	     fabs(sum([Сумм. оборот Дт-Кт]))		as Сумма 
	FROM
		[$(vSrcPath_SAP_ZKHDCP056)\ZKHDCP056_QRY001_202*_C1202330.qvd]
		(qvd)
	Where 
		[1С: Счет] like '90.01*'
	Group By
		date(DayStart(MonthEnd(MakeDate(Mid([Финансовый год/период],5,4),Right([Финансовый год/период],2)))))	
		; 
ENDSUB


///$tab ДДС
SUB ДДС

	/////////////////////////////////////////ИСХОДЯЩИЕ ПЛАТЕЖИ ДДС
	Concatenate (Данные)
	LOAD 
		'АРМ БДДС' 								as [Источник данных],
	     [ДО Наименование], 
	     Дата, 
	     'УО' 									as [Признак УО/МСФО],
	     Сумма, 
	     'ВОК' 									as Лист,
	     'Исходящие платежи ДДС' 				as [Признак Данные],
		 [БДДС Группа2]
	FROM
		[$(vDataTier3)\Дашборд ВОК\Лист_2 БДДС\ДДС_ДляВОК.qvd]
		(qvd);
		
ENDSUB

///$tab КЗ налоги
SUB КЗ_Налоги

	/////////////////////////////////////////КЗ НАЛОГИ НА КОНЕЦ
	Concatenate (Данные)
	LOAD 
		 'ZKHDCP050' 												as [Источник данных],
		 'ВОК' 														as Лист,
		 'УО' 														as [Признак УО/МСФО],
		 'КЗ налоги на конец' 										as [Признак Данные],
		 Период														as Дата, 
	     [ДО Наименование],
	     fabs([Сумма на конец])										as Сумма
	FROM
		[$(vDataTier2)\FactTables\Дашборд ВОК\SAP\ZKHDCP050\ZKHDCP050_Налоги.qvd]
		(qvd)
	Where 
		[Сумма на конец]<>0;

ENDSUB

///$tab Бенчмарк
SUB Бенчмарк

	/////////////////////////////////////////EBITDA из СПО
	Concatenate (Данные)
	LOAD 
		'СПО' 				as [Источник данных],
		'ВОК' 				as Лист,
		'УО' 				as [Признак УО/МСФО],
		'EBITDA СПО' 		as [Признак Данные], 
	    ДО 					as [ДО Наименование], 
	    Дата, 
	    Данные 				as Сумма
	FROM
		[$(vDataTier3)\Дашборд ВОК\Прогноз\Ebitda_СПО.qvd]
		(qvd);

	/////////////////////////////////////////Финансирование из СПО
	Concatenate (Данные)
	LOAD 
		'СПО' 						as [Источник данных],
		'ВОК' 						as Лист,
		'УО' 						as [Признак УО/МСФО],
		'Финансирование CAPEX СПО' 	as [Признак Данные], 
	    ДО 							as [ДО Наименование], 
	    Дата, 
	    (-1)*(Данные)				as Сумма //в СПО сумма здесь отрицательная, беру с противоположным знаком
	FROM
		[$(vDataTier3)\Дашборд ВОК\Прогноз\Финансирование_CAPEX.qvd]
		(qvd);
	
	/////////////////////////////////////////Добыча в тыс тнэ
	Concatenate (Данные)
	LOAD 
		'СПО' 						as [Источник данных],
		'ВОК' 						as Лист,
		'УО' 						as [Признак УО/МСФО],
		'Добыча УВ, тыс.тнэ' 		as [Признак Данные], 
	    ДО 							as [ДО Наименование], 
	    Дата, 
	    Данные						as Сумма //Добыча УВ (с учётом ЖУВ), тыс.тнэ
	FROM
		[$(vDataTier3)\Дашборд ВОК\Прогноз\Добыча.qvd]
		(qvd);

ENDSUB


///$tab Факторинг
SUB КЗ_Факторинг
	
	//факт факторинга из витрины 410
	Concatenate (Данные)		
	LOAD *
	Where 
	   [Факторинг.КЗ погашение (оборот Дт) руб.]<>0
	or [Факторинг.КЗ увеличение (оборот Кт) руб.]<>0
	or [факторинг.КЗ на начало периода руб.]<>0
	or [факторинг.КЗ на конец периода руб.]<>0;	
	LOAD 
		 'ВОК' 																as Лист,
		 'УО' 																as [Признак УО/МСФО],
		 'Факторинг' 														as [Признак Данные],
		 [ДО Наименование], 
		 Дата, 	
		 [Контрагент Наименование],
		 sum( [КЗ на конец периода (без отрицательных сальдо), руб.])		as Сумма,		 
		 [Тип платежа]														as [Факторинг.Тип платежа], 
	     [Бухгалтерский счет]												as [Факторинг.Бухгалтерский счет], 	     
	     sum([КЗ погашение (оборот Дт) (без отрицательных сальдо), руб.])	as [Факторинг.КЗ погашение (оборот Дт) руб.], 
	     sum([КЗ увеличение (оборот Кт) (без отрицательных сальдо), руб.])	as [Факторинг.КЗ увеличение (оборот Кт) руб.],
	     sum([КЗ на начало периода (без отрицательных сальдо), руб.])		as [факторинг.КЗ на начало периода руб.],
	     sum([КЗ на конец периода (без отрицательных сальдо), руб.])		as [факторинг.КЗ на конец периода руб.]
	FROM
		[$(vDataTier3)\Дашборд ВОК\Лист_0 Общий\КЗ_Факторинг.qvd]
		(qvd)
	Group By
		[ДО Наименование], 
		Дата, 	
		[Контрагент Наименование], 		 
		[Тип платежа], 
	    [Бухгалтерский счет];		

ENDSUB
///$tab Transform
SUB Transform

	NoConcatenate
	Данные_:
	LOAD
		[Срез данных], //поле для планов по МТр
		[Источник данных],
		[Контрагент Наименование],
		Date(Дата) as Период,
		[ДО Наименование],
		applymap('ТИП_ДО', [ДО Наименование], Null()) as [ТИП ДО],
		Лист,
		Материал,
		[Контрагент Код],
		[Контрагент Тип],
		[Признак НЭЗ],
		Проект as [ВОК Проект],
		[Признак УО/МСФО],
		[Признак Данные],
		Сумма,
		[Признак МТР],
		[БДДС Группа2],
		[Признак расхода],
		[Потери. Признак ВГО],
		[Фильтр в Карте МТР 1 уровень],
		[Признак НЭЗ больше 3 лет в запасе],
		
		//из факторинга
		[Факторинг.Тип платежа], 
	    [Факторинг.Бухгалтерский счет], 	     
	    [Факторинг.КЗ погашение (оборот Дт) руб.], 
	    [Факторинг.КЗ увеличение (оборот Кт) руб.],
	    [факторинг.КЗ на начало периода руб.],
	    [факторинг.КЗ на конец периода руб.],	     
	     
		if([Признак Данные]='Запас МТР на конец' and [Признак МТР]='МТР с учетом ВНА', 	'МТР',
		if([Признак Данные]='КЗ на конец', 			'КЗ',
		if([Признак Данные]='Авансы на конец', 		'Авансы',
		if([Признак Данные]='ДЗ на конец', 			'ДЗ', 
		if([Признак Данные]='Факторинг', 			'Факторинг',Null()))))) as ВОК_ДляФормулы
	Resident 
		Данные
	Where 
		Year(Дата)>='$(vYear_Dashboard)';
	
	DROP Table Данные, ДО_ВОК;

ENDSUB
///$tab Календарь
SUB Календарь

	[Количество дней в месяце]:
	LOAD Distinct
		 Период,
		 Day(MonthEnd(Период)) as [Количество дней в месяце]
	Resident 
		Данные_
	Where
		Период<=YearEnd(addyears('$(vToday)',1))
		;
	
	//перебор всех дат
	Календарь:
	LOAD Distinct
		Период as [Дата отчета]
	Resident 
		[Количество дней в месяце];	
	
	Left Join (Календарь)
	LOAD
		[Дата отчета] as [Дата отчета 1]
	Resident Календарь;

	[Календарь оборачиваемость]:
	LOAD
		[Дата отчета] 																		as Период,
		if([Дата отчета 1]<='$(vToday)',1,0)												as [YTM], //1 -это даты по текущий месяц
		Floor(Interval#([Дата отчета 1]-([Дата отчета]-5), 'D')/30) 						as СчетчикМесяцев,
		if([Дата отчета]>=date(DayStart(YearStart([Дата отчета 1]))), 1, 0)					as [Признак с начала года],
		if(Month([Дата отчета])=1, 1, 0) 													as [Признак начала года],
		'ДЗ_КЗ' 																			as [Признак календарь],//убрать поле
		Date([Дата отчета 1])																as [Дата для оборачиваемости],
		if([Дата отчета]=[Дата отчета 1], 1,0) 												as [Признак конец периода], //убрать поле
		if([Дата отчета]=date(DayStart(MonthEnd(AddMonths([Дата отчета 1],-11)))), 1, 0) 	as [Признак начало периода] //убрать поле
	Resident 
		Календарь
	Where 
		[Дата отчета 1]>=[Дата отчета]; 
	
	DROP Table Календарь;

ENDSUB
///$tab STORE
SUB Store
 
	STORE Данные_ 						into $(vDataTier3)\Дашборд ВОК\Лист_1 ВОК\Данные_ВОК_УО.qvd;
	STORE [Календарь оборачиваемость] 	into $(vDataTier3)\Дашборд ВОК\Лист_1 ВОК\Календарь оборачиваемость.qvd;
	STORE [Количество дней в месяце] 	into $(vDataTier3)\Дашборд ВОК\Лист_1 ВОК\Количество дней в месяце.qvd;

ENDSUB

